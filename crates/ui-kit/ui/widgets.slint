import { Theme } from "theme.slint";

// The font that carries the icons.
//
// It is downloaded when the crate is built and embedded into the program, so
// the icons look the same on every machine.
import "../fonts/MaterialIcons-Regular.ttf";

// A single glyph of the icon font.
//
// The font is downloaded when the crate is built and embedded into the
// program, so the icons look the same on every machine.
export component Icon inherits Text {
    in property <string> glyph: "";
    in property <color> ink: Theme.fg;
    in property <length> size: 16px;

    text: root.glyph;
    font-family: "Material Icons";
    font-size: root.size;
    color: root.ink;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// The triangle that marks the play button.
export component PlayIcon inherits Icon {
    glyph: "\u{e037}";
}

// The two bars that mark the pause button.
export component PauseIcon inherits Icon {
    glyph: "\u{e034}";
}

// A small triangle that points down.
export component ChevronIcon inherits Icon {
    glyph: "\u{e5c5}";
    size: 14px;
    ink: Theme.muted;
}

// The four corners that mark the full screen button.
export component FullscreenIcon inherits Icon {
    glyph: "\u{e5d0}";
}

// The inward corners that mark the way out of full screen.
export component FullscreenExitIcon inherits Icon {
    glyph: "\u{e5d1}";
}

// The television that marks a live stream.
export component LiveIcon inherits Icon {
    glyph: "\u{e639}";
    ink: Theme.danger;
}

// The dot that marks the live button.
export component LiveDot inherits Icon {
    glyph: "\u{e061}";
    ink: Theme.danger;
    size: 10px;
}

// The cog that opens the source picker.
export component GearIcon inherits Icon {
    glyph: "\u{e8b8}";
    ink: Theme.muted;
}

// The loudspeaker that marks the volume slider.
export component VolumeIcon inherits Icon {
    glyph: "\u{e050}";
    ink: Theme.muted;
}

// The loudspeaker with a slash, used when the volume is muted.
export component VolumeOffIcon inherits Icon {
    glyph: "\u{e04f}";
    ink: Theme.muted;
}

// The arrow that points back in time.
export component ReplayIcon inherits Icon {
    glyph: "\u{e059}";
}

// A flat button with a text label.
export component FlatButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    callback pointer-activity();

    border-radius: 6px;
    border-width: 1px;
    border-color: root.primary ? Theme.accent : Theme.border;
    background: root.primary ? Theme.accent : (touch.pressed ? Theme.elevated : Theme.panel);
    opacity: root.enabled ? 1 : 0.45;

    Text {
        text: root.label;
        color: root.primary ? Theme.on-accent : Theme.fg;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
        moved => { root.pointer-activity(); }
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The button that starts and stops the playback.
export component PlayPauseButton inherits Rectangle {
    in property <bool> playing: false;
    callback clicked();
    callback pointer-activity();

    width: 44px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.elevated : Theme.panel;

    icon := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        background: transparent;

        if !root.playing: PlayIcon {
            x: 0px;
            y: 0px;
            width: 16px;
            height: 16px;
        }
        if root.playing: PauseIcon {
            x: 0px;
            y: 0px;
            width: 16px;
            height: 16px;
        }
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
        moved => { root.pointer-activity(); }
        clicked => {
            root.clicked();
        }
    }
}

// The button that switches between windowed and full screen.
export component FullscreenButton inherits Rectangle {
    in property <bool> fullscreen: false;
    callback clicked();
    callback pointer-activity();

    width: 40px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed ? Theme.elevated : Theme.panel;

    if !root.fullscreen: FullscreenIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.fullscreen: FullscreenExitIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
        moved => { root.pointer-activity(); }
        clicked => {
            root.clicked();
        }
    }
}

// The button that jumps back to the live edge of a live stream.
//
// It is only shown while a live stream is playing, the same way YouTube
// only shows it for live streams. It is red while the playback sits at the
// edge and grey while the user is behind it, so the button doubles as a
// status light.
export component LiveButton inherits Rectangle {
    in property <bool> at-edge: true;
    in property <string> label: "LIVE";
    callback clicked();
    callback pointer-activity();

    width: 82px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.at-edge ? Theme.danger : Theme.border;
    background: touch.pressed ? Theme.elevated : Theme.panel;

    LiveDot {
        x: 8px;
        y: (parent.height - self.height) / 2;
        ink: root.at-edge ? Theme.danger : Theme.muted;
    }

    Text {
        x: 22px;
        width: parent.width - 28px;
        text: root.label;
        color: root.at-edge ? Theme.danger : Theme.muted;
        font-size: 12px;
        font-weight: root.at-edge ? 700 : 400;
        vertical-alignment: center;
    }

    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
        moved => { root.pointer-activity(); }
        clicked => {
            root.clicked();
        }
    }
}

// The button that opens the source picker.
export component GearButton inherits Rectangle {
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();
    callback pointer-activity();

    width: 36px;
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: touch.pressed ? Theme.elevated : Theme.panel;
    opacity: root.enabled ? 1 : 0.45;

    GearIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        ink: root.active ? Theme.accent : Theme.muted;
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
        moved => { root.pointer-activity(); }
        clicked => {
            root.clicked();
        }
    }
}

// A horizontal slider.
//
// The slider reports the position the user picked through the `moved`
// callback; the caller decides what to do with it. The part that has been
// played is filled from the left and grows to the right, the same way a
// progress bar does.
export component SeekBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    in property <bool> interactive: true;
    callback moved(float);
    callback pointer-activity();

    height: 18px;

    // The position of the handle, between 0 and 1. The clamp keeps a slider
    // whose maximum is still unknown (a live stream before the first tick)
    // from drawing its fill in the middle of the track.
    out property <float> ratio: root.maximum > 0
        ? clamp(root.value / root.maximum, 0.0, 1.0)
        : 0.0;

    track := Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 12px);
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
    }

    fill := Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 12px) * root.ratio;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }

    knob := Rectangle {
        x: 6px + max(0px, parent.width - 12px) * root.ratio - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        visible: root.interactive && root.maximum > 0;
    }

    area := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        enabled: root.interactive;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
            if (event.kind == PointerEventKind.down) {
                root.moved(root.value-at(area.mouse-x));
            }
            if (event.kind == PointerEventKind.up) {
                root.moved(root.value-at(area.mouse-x));
            }
        }
        moved => {
            root.pointer-activity();
            root.moved(root.value-at(area.mouse-x));
        }
    }

    // The value for a horizontal position inside the slider.
    pure function value-at(x: length) -> float {
        root.width <= 0px || root.maximum <= 0
            ? 0.0
            : clamp(((x - 6px) / max(1px, root.width - 12px)) * root.maximum, 0.0, root.maximum)
    }
}
