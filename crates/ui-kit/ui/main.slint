import { ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FlatButton, FullscreenButton, GearButton, LiveButton, PlayPauseButton, SeekBar, VolumeIcon, VolumeOffIcon } from "widgets.slint";
import { TopBar } from "slint-ui/TopBar.slint";
import { VideoPlayer } from "slint-ui/VideoPlayer.slint";
import { VideoHeader } from "slint-ui/VideoHeader.slint";
import { PlayerControls } from "slint-ui/PlayerControls.slint";
import { SourcePicker } from "slint-ui/SourcePicker.slint";
import { PendingDialog } from "slint-ui/PendingDialog.slint";
import { ToastList, ToastItem } from "slint-ui/Toast.slint";
import { SourceColumn } from "slint-ui/SourceColumn.slint";
import { Sidebar } from "slint-ui/Sidebar.slint";
import { QueueDialog } from "slint-ui/QueueDialog.slint";
import { HistoryDialog } from "slint-ui/HistoryDialog.slint";
import { PlaylistDialog } from "slint-ui/PlaylistDialog.slint";
import { CreatePlaylistDialog } from "slint-ui/CreatePlaylistDialog.slint";
import {
    PlaylistItem, StreamItem, QueueItem, HistoryItem, BufferedRange, SponsorSegment
} from "slint-ui/types.slint";

import "../fonts/Inter.ttf";
import "../fonts/NotoSansCJKsc-VF.ttf";
import "../fonts/NotoSansSymbols2.ttf";
import "../fonts/NotoColorEmoji.ttf";
import "../fonts/STIXTwoMath.ttf";

// The shell of the player: a URL bar on top, the video below it.
//
// The video itself is *not* drawn here. mpv draws it into the lower part of
// the window before Slint renders this scene, and every part of the scene
// that stays transparent lets that frame through.
export component MainWindow inherits Window {
    title: root.has-media ? root.media-title + " \u{2014} Flatline " + root.app-version : "Flatline " + root.app-version;
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 340px;
    background: root.has-media ? transparent : Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    // ------------------------------------------------------------- state --
    in-out property <string> url: "";
    in property <string> media-title: "";
    in property <string> media-uploader: "";
    in property <string> app-version: "";
    in property <string> status: "";
    // "info", "busy" or "error".
    in property <string> status-kind: "info";
    // The streams the source offers, split into the three picker columns.
    in property <[StreamItem]> video-sources: [];
    in property <[StreamItem]> audio-sources: [];
    in property <[StreamItem]> muxed-sources: [];
    // The streams that are currently playing.
    in-out property <string> selected-video-id: "";
    in-out property <string> selected-audio-id: "";
    in-out property <string> selected-muxed-id: "";
    // Whether the source picker is open. The host closes it on a new load.
    in-out property <bool> sources-open: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> settings-speed-mode: false;
    in property <float> playback-speed: 1.0;
    in property <string> source-quality-label: "Auto";
    in property <bool> has-media: false;
    in property <image> video-thumbnail;
    // Whether the media that plays has no video track (audio only source).
    in property <bool> audio-only: false;
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    // The parts of the axis that are already downloaded, as fractions.
    in property <[BufferedRange]> buffered-ranges: [];
    // The marked segments, such as SponsorBlock spans, as fractions.
    in property <[SponsorSegment]> sponsor-segments: [];
    in property <float> volume: 100;
    // The playback position, formatted for the user.
    in property <string> time-text: "0:00 / 0:00";
    // Whether the media is a live stream.
    in property <bool> live: false;
    // Whether the playback is at the live edge.
    in property <bool> at-live-edge: true;
    // Whether the window is in full screen.
    in property <bool> fullscreen: false;
    // The small note in the corner, shown while a URL is parsed in the
    // background.
    in-out property <[ToastItem]> toasts: [];
    // The dialog that asks what to do with a media that was resolved while
    // another one already plays.
    in-out property <bool> pending-open: false;
    in property <string> pending-title: "";
    in property <image> pending-thumbnail;
    in property <bool> pending-is-playlist: false;
    in property <bool> pending-has-selected-video: false;
    in property <int> pending-playlist-count: 0;
    in-out property <bool> update-open: false;
    in property <string> update-title: "Update available";
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in property <string> update-action-label: "Yes, download and install";
    in-out property <bool> update-installing: false;
    in-out property <string> update-status-text: "Downloading update?";
    in property <string> update-error: "";
    // The progress of the download of an update package.
    in-out property <float> update-download-progress: 0;
    in-out property <bool> error-open: false;
    in property <string> error-title: "URL could not be processed";
    in property <string> error-message: "";
    // The drawer that opens under the top bar when the mascot is clicked.
    in-out property <bool> sidebar-open: false;
    // The queue and history lists shown from the sidebar.
    in-out property <bool> queue-open: false;
    // "Queue" or "Queue [name]" for the active playlist.
    in property <string> queue-title: "Queue";
    in property <bool> queue-in-playlist: false;
    in property <[QueueItem]> queue-items: [];
    in property <int> queue-current-index: -1;
    in property <int> queue-current-id: -1;
    in property <int> queue-long-press-index: -1;
    in-out property <length> queue-content-y: 0px;
    in-out property <length> queue-drag-pointer-y: 0px;
    in-out property <bool> queue-drag-scroll-tick: false;
    in-out property <bool> history-open: false;
    in property <[HistoryItem]> history-items: [];
    // The playlist list and the name dialog that opens over it.
    in-out property <bool> playlists-open: false;
    in property <[PlaylistItem]> playlist-items: [];
    in-out property <bool> create-playlist-open: false;
    in-out property <string> create-playlist-duplicate: "";
    // Whether the pending dialog belongs to a user playlist.
    in property <bool> pending-in-playlist: false;

    // ------------------------------------------------------------ events --
    callback load-requested();
    callback url-edited(string);
    callback sources-applied(string, string, string);
    callback playback-speed-changed(float);
    callback play-toggled();
    callback seek-requested(float);
    callback volume-requested(float);
    callback volume-toggled();
    callback fullscreen-toggled();
    callback live-requested();
    callback pointer-activity();
    callback controls-hovered(bool);
    callback interacting-changed(bool);
    callback previous-requested();
    callback next-requested();
    callback pending-play-requested();
    callback pending-queue-requested();
    callback pending-queue-next-requested();
    callback pending-play-selected-requested();
    callback pending-dismissed();
    callback update-accepted();
    callback update-dismissed();
    callback error-dismissed();
    callback queue-requested();
    callback playlists-requested();
    callback playlist-selected(string);
    callback create-playlist(string);
    callback confirm-create-playlist(string);
    callback create-playlist-dismissed();
    callback history-requested();
    callback queue-item-selected(int);
    callback queue-copy-url(string);
    callback queue-remove-entry(int);
    callback queue-move-requested(int, int);
    callback queue-row-pressed(int);
    callback queue-row-released(int);
    callback queue-add-to-playlist(int, string);
    callback queue-move-to-playlist(int, string);
    callback queue-add-to-new-playlist(int);
    callback queue-move-to-new-playlist(int);
    callback pending-add-to-playlist(string);
    callback pending-add-to-new-playlist();
    callback pending-play-playlist-requested();
    callback pending-play-playlist-new-requested();
    callback pending-append-playlist(string);
    callback pending-append-playlist-new();
    callback history-item-selected(string);
    callback outside-clicked();

    // --------------------------------------------------------- internals --
    // The picker edits a draft, so cancelling leaves the playing selection
    // untouched.
    private property <string> draft-video: "";
    private property <string> draft-audio: "";
    private property <string> draft-muxed: "";

    // The height of the top bar, so that the host knows how much of the
    // window the video may use.
    out property <length> top-bar-height: Theme.bar-height;

    in property <bool> controls-visible: true;
    // Which of the three loading dots is lit up, from zero to two.
    in property <int> spinner-step: 0;

    private property <bool> can-apply: root.draft-video != ""
        || root.draft-audio != ""
        || root.draft-muxed != "";

    function open-sources() {
        root.draft-video = root.selected-video-id;
        root.draft-audio = root.selected-audio-id;
        root.draft-muxed = root.selected-muxed-id;
        root.settings-open = false;
        root.settings-speed-mode = false;
        root.sources-open = true;
    }

    function toggle-settings() {
        // The gear always shows the base popup: when the speed slider is
        // open it returns to the sources/speed rows, and only an already
        // open base menu toggles closed.
        if (root.settings-open && !root.settings-speed-mode) {
            root.settings-open = false;
        } else {
            root.sources-open = false;
            root.settings-speed-mode = false;
            root.settings-open = true;
        }
    }

    function close-settings() {
        // A click outside the popup always closes it, including when the
        // playback-speed slider is the visible level.
        root.settings-open = false;
        root.settings-speed-mode = false;
    }

    function toggle-video(id: string) {
        root.draft-muxed = "";
        root.draft-video = root.draft-video == id ? "" : id;
    }

    function toggle-audio(id: string) {
        root.draft-muxed = "";
        root.draft-audio = root.draft-audio == id ? "" : id;
    }

    function toggle-muxed(id: string) {
        if (root.draft-muxed == id) {
            root.draft-muxed = "";
        } else {
            root.draft-muxed = id;
            root.draft-video = "";
            root.draft-audio = "";
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        moved => { root.pointer-activity(); }
        // A click that is not taken by the bar or a button lands here, so
        // the URL bar learns that the user clicked away from it.
        clicked => { root.outside-clicked(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
    }

    // Video area with status display
    VideoPlayer {
        x: 0;
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        container-height: parent.height - Theme.bar-height;
        status: root.status;
        status-kind: root.status-kind;
        spinner-step: root.spinner-step;
        has-media: root.has-media;
        audio-only: root.audio-only;
        video-thumbnail: root.video-thumbnail;
        controls-visible: root.controls-visible;
        pointer-activity => { root.pointer-activity(); }
    }

    // Video header (title and channel) overlay below top bar
    VideoHeader {
        x: 0;
        width: parent.width;
        title: root.media-title;
        uploader: root.media-uploader;
        has-media: root.has-media;
        controls-visible: root.controls-visible;
        pointer-activity => { root.pointer-activity(); }
    }

    // Top bar with URL field
    top-bar := TopBar {
        x: 0;
        y: 0;
        width: parent.width;
        url <=> root.url;
        load-requested => { root.load-requested(); }
        pointer-activity => { root.pointer-activity(); }
        brand-clicked => { root.sidebar-open = !root.sidebar-open; }
    }

    public function blur-url() {
        top-bar.blur-url();
    }

    // Control bar
    PlayerControls {
        x: 0;
        y: root.controls-visible ? parent.height - Theme.controls-height : parent.height;
        width: parent.width;
        height: Theme.controls-height;
        container-height: parent.height - Theme.bar-height;
        playing: root.playing;
        position: root.position;
        duration: root.duration;
        buffered-ranges: root.buffered-ranges;
        sponsor-segments: root.sponsor-segments;
        volume: root.volume;
        time-text: root.time-text;
        live: root.live;
        at-live-edge: root.at-live-edge;
        fullscreen: root.fullscreen;
        settings-open: root.settings-open;
        settings-speed-mode: root.settings-speed-mode;
        source-quality-label: root.source-quality-label;
        playback-speed: root.playback-speed;
        has-media: root.has-media;
        controls-visible: root.controls-visible;
        play-toggled => { root.play-toggled(); }
        seek-requested(value) => { root.seek-requested(value); }
        volume-requested(value) => { root.volume-requested(value); }
        volume-toggled => { root.volume-toggled(); }
        fullscreen-toggled => { root.fullscreen-toggled(); }
        live-requested => { root.live-requested(); }
        previous-requested => { root.previous-requested(); }
        next-requested => { root.next-requested(); }
        pointer-activity => { root.pointer-activity(); }
        controls-hovered(hovered) => { root.controls-hovered(hovered); }
        interacting-changed(interacting) => { root.interacting-changed(interacting); }
        settings-toggled => { root.toggle-settings(); }
        settings-closed => { root.close-settings(); }
        sources-requested => { root.open-sources(); }
        speed-mode-requested => { root.settings-speed-mode = true; }
        speed-changed(value) => { root.playback-speed-changed(value); }
    }

    // Sidebar drawer, above the video and its overlays.
    Sidebar {
        width: parent.width;
        height: parent.height;
        open: root.sidebar-open;
        queue-clicked => {
            root.sidebar-open = false;
            root.queue-requested();
        }
        playlists-clicked => {
            root.sidebar-open = false;
            root.playlists-requested();
        }
        history-clicked => {
            root.sidebar-open = false;
            root.history-requested();
        }
        dismissed => { root.sidebar-open = false; }
    }

    // Toast notifications (auto-dismiss after 10s, stacked, max 5)
    ToastList {
        width: min(380px, parent.width - 40px);
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - Theme.controls-height - 12px;
        toasts: root.toasts;
        toast-max-width: 380px;
    }

    // Source picker
    if root.sources-open: SourcePicker {
        width: parent.width;
        height: parent.height;
        video-sources: root.video-sources;
        audio-sources: root.audio-sources;
        muxed-sources: root.muxed-sources;
        selected-video-id <=> root.draft-video;
        selected-audio-id <=> root.draft-audio;
        selected-muxed-id <=> root.draft-muxed;
        sources-open <=> root.sources-open;
        sources-applied(v, a, m) => {
            root.selected-video-id = v;
            root.selected-audio-id = a;
            root.selected-muxed-id = m;
            root.sources-applied(v, a, m);
        }
        pointer-activity => { root.pointer-activity(); }
    }

    // Pending dialog
    if root.pending-open: PendingDialog {
        width: parent.width;
        height: parent.height;
        pending-title: root.pending-title;
        pending-thumbnail: root.pending-thumbnail;
        in-playlist: root.pending-in-playlist;
        pending-is-playlist: root.pending-is-playlist;
        pending-has-selected-video: root.pending-has-selected-video;
        pending-playlist-count: root.pending-playlist-count;
        playlists: root.playlist-items;
        pending-open <=> root.pending-open;
        pending-play-requested => { root.pending-play-requested(); }
        pending-queue-requested => { root.pending-queue-requested(); }
        pending-queue-next-requested => { root.pending-queue-next-requested(); }
        pending-play-selected-requested => { root.pending-play-selected-requested(); }
        pending-add-to-playlist(id) => { root.pending-add-to-playlist(id); }
        pending-add-to-new-playlist => { root.pending-add-to-new-playlist(); }
        pending-play-playlist-requested => { root.pending-play-playlist-requested(); }
        pending-play-playlist-new-requested => { root.pending-play-playlist-new-requested(); }
        pending-append-playlist(id) => { root.pending-append-playlist(id); }
        pending-append-playlist-new => { root.pending-append-playlist-new(); }
        pending-dismissed => { root.pending-dismissed(); }
    }

    // Active queue dialog
    if root.queue-open: QueueDialog {
        width: parent.width;
        height: parent.height;
        title: root.queue-title;
        items: root.queue-items;
        current-index: root.queue-current-index;
        current-id: root.queue-current-id;
        long-press-index: root.queue-long-press-index;
        in-playlist: root.queue-in-playlist;
        playlists: root.playlist-items;
        queue-content-y <=> root.queue-content-y;
        drag-pointer-y <=> root.queue-drag-pointer-y;
        drag-scroll-tick: root.queue-drag-scroll-tick;
        open <=> root.queue-open;
        item-selected(position) => { root.queue-item-selected(position); }
        copy-url(url) => { root.queue-copy-url(url); }
        remove-entry(id) => { root.queue-remove-entry(id); }
        move-requested(src, tgt) => { root.queue-move-requested(src, tgt); }
        queue-row-pressed(index) => { root.queue-row-pressed(index); }
        queue-row-released(index) => { root.queue-row-released(index); }
        add-to-playlist(entry, playlist) => { root.queue-add-to-playlist(entry, playlist); }
        move-to-playlist(entry, playlist) => { root.queue-move-to-playlist(entry, playlist); }
        add-to-new-playlist(entry) => { root.queue-add-to-new-playlist(entry); }
        move-to-new-playlist(entry) => { root.queue-move-to-new-playlist(entry); }
        dismissed => { root.queue-open = false; }
    }

    // History dialog
    if root.history-open: HistoryDialog {
        width: parent.width;
        height: parent.height;
        items: root.history-items;
        open <=> root.history-open;
        item-selected(url) => { root.history-item-selected(url); }
        dismissed => { root.history-open = false; }
    }

    // Playlist list and the name dialog that opens over it.
    if root.playlists-open: PlaylistDialog {
        width: parent.width;
        height: parent.height;
        items: root.playlist-items;
        open <=> root.playlists-open;
        playlist-selected(id) => { root.playlist-selected(id); }
        create-requested => { root.create-playlist-open = true; }
        dismissed => { root.playlists-open = false; }
    }

    if root.create-playlist-open: CreatePlaylistDialog {
        width: parent.width;
        height: parent.height;
        duplicate-name <=> root.create-playlist-duplicate;
        open <=> root.create-playlist-open;
        create(name) => { root.create-playlist(name); }
        confirm-create(name) => { root.confirm-create-playlist(name); }
        dismissed => {
            root.create-playlist-open = false;
            root.create-playlist-duplicate = "";
            root.create-playlist-dismissed();
        }
    }

    if root.update-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000099;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(560px, parent.width - 40px);
            height: min(460px, parent.height - 40px);
            background: Theme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.update-installing ? root.update-status-text : root.update-title;
                    color: Theme.fg;
                    font-size: 20px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Version " + root.update-version;
                    color: Theme.muted;
                }
                if !root.update-installing: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-right: 12px;
                        Text {
                            text: root.update-notes == "" ? "No release notes provided." : root.update-notes;
                            color: Theme.fg;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.update-installing: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: root.update-status-text;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 10px;
                        border-radius: 5px;
                        background: Theme.border;
                        Rectangle {
                            x: 2px;
                            y: 2px;
                            width: max(0px, (parent.width - 4px) * clamp(root.update-download-progress, 0.0, 1.0));
                            height: parent.height - 4px;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: Math.round(clamp(root.update-download-progress, 0.0, 1.0) * 100) + "%";
                        color: Theme.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
                if root.update-error != "": Text {
                    text: root.update-error;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    if !root.update-installing && root.update-error == "": Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: btn1.pressed ? Theme.elevated : (btn1.has-hover ? Theme.elevated : Theme.panel);
                        Text {
                            text: "No";
                            color: Theme.fg;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn1 := TouchArea {
                            clicked => {
                                root.update-open = false;
                                root.update-dismissed();
                            }
                        }
                    }
                    if !root.update-installing && root.update-error == "": Rectangle {
                        width: 220px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.accent;
                        background: btn2.pressed ? #5a9bf5 : (btn2.has-hover ? #5a9bf5 : Theme.accent);
                        Text {
                            text: root.update-action-label;
                            color: Theme.on-accent;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn2 := TouchArea {
                            clicked => {
                                root.update-installing = true;
                                root.update-status-text = "Downloading update…";
                                root.update-download-progress = 0.0;
                                root.update-accepted();
                            }
                        }
                    }
                    if root.update-installing && root.update-error == "": ProgressIndicator {
                        indeterminate: root.update-download-progress <= 0.0 || root.update-download-progress >= 1.0;
                    }
                    if root.update-error != "": Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: btn3.pressed ? Theme.elevated : (btn3.has-hover ? Theme.elevated : Theme.panel);
                        Text {
                            text: "Close";
                            color: Theme.fg;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn3 := TouchArea {
                            clicked => {
                                root.update-open = false;
                                root.update-dismissed();
                            }
                        }
                    }
                }
            }
        }
    }
    if root.error-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000099;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 40px);
            // The dialog keeps its height no matter how long the message is,
            // so a long error scrolls instead of pushing the dialog off the
            // screen.
            height: min(300px, parent.height - 40px);
            background: Theme.panel;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.error-title;
                    color: Theme.fg;
                    font-size: 20px;
                    wrap: word-wrap;
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        padding-right: 10px;
                        Text {
                            text: root.error-message;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Rectangle {
                        width: 80px;
                        height: 34px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: err-close.pressed ? Theme.elevated : (err-close.has-hover ? Theme.elevated : Theme.panel);
                        Text {
                            text: "OK";
                            color: Theme.fg;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        err-close := TouchArea {
                            clicked => {
                                root.error-open = false;
                                root.error-dismissed();
                            }
                        }
                    }
                }
            }
        }
    }

}
