import { Button, ProgressIndicator, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FlatButton, FullscreenButton, GearButton, LiveButton, PlayPauseButton, SeekBar, VolumeIcon, VolumeOffIcon } from "widgets.slint";
import { TopBar } from "slint-ui/TopBar.slint";
import { VideoPlayer } from "slint-ui/VideoPlayer.slint";
import { VideoHeader } from "slint-ui/VideoHeader.slint";
import { PlayerControls } from "slint-ui/PlayerControls.slint";
import { SourcePicker } from "slint-ui/SourcePicker.slint";
import { PendingDialog } from "slint-ui/PendingDialog.slint";
import { Toast } from "slint-ui/Toast.slint";
import { SourceColumn } from "slint-ui/SourceColumn.slint";
import { StreamItem } from "slint-ui/types.slint";

import "../fonts/Inter.ttf";

// The shell of the player: a URL bar on top, the video below it.
//
// The video itself is *not* drawn here. mpv draws it into the lower part of
// the window before Slint renders this scene, and every part of the scene
// that stays transparent lets that frame through.
export component MainWindow inherits Window {
    title: root.has-media ? root.media-title + " \u{2014} Flatline" : "Flatline";
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 340px;
    background: root.has-media ? transparent : Theme.bg;
    default-font-family: "Inter";
    default-font-size: 13px;

    // ------------------------------------------------------------- state --
    in-out property <string> url: "";
    in property <string> media-title: "";
    in property <string> media-uploader: "";
    in property <string> status: "";
    // "info", "busy" or "error".
    in property <string> status-kind: "info";
    // The streams the source offers, split into the three picker columns.
    in property <[StreamItem]> video-sources: [];
    in property <[StreamItem]> audio-sources: [];
    in property <[StreamItem]> muxed-sources: [];
    // The streams that are currently playing.
    in-out property <string> selected-video-id: "";
    in-out property <string> selected-audio-id: "";
    in-out property <string> selected-muxed-id: "";
    // Whether the source picker is open. The host closes it on a new load.
    in-out property <bool> sources-open: false;
    in property <bool> has-media: false;
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 100;
    // The playback position, formatted for the user.
    in property <string> time-text: "0:00 / 0:00";
    // Whether the media is a live stream.
    in property <bool> live: false;
    // Whether the playback is at the live edge.
    in property <bool> at-live-edge: true;
    // Whether the window is in full screen.
    in property <bool> fullscreen: false;
    // The small note in the corner, shown while a URL is parsed in the
    // background.
    in-out property <bool> toast-visible: false;
    in property <string> toast-text: "";
    // The dialog that asks what to do with a media that was resolved while
    // another one already plays.
    in-out property <bool> pending-open: false;
    in property <string> pending-title: "";
    in property <image> pending-thumbnail;
    in-out property <bool> update-open: false;
    in property <string> update-version: "";
    in property <string> update-notes: "";
    in-out property <bool> update-installing: false;
    in property <string> update-error: "";

    // ------------------------------------------------------------ events --
    callback load-requested();
    callback sources-applied(string, string, string);
    callback play-toggled();
    callback seek-requested(float);
    callback volume-requested(float);
    callback volume-toggled();
    callback fullscreen-toggled();
    callback live-requested();
    callback pointer-activity();
    callback controls-hovered(bool);
    callback interacting-changed(bool);
    callback pending-play-requested();
    callback pending-queue-requested();
    callback pending-dismissed();
    callback update-accepted();
    callback update-dismissed();

    // --------------------------------------------------------- internals --
    // The picker edits a draft, so cancelling leaves the playing selection
    // untouched.
    private property <string> draft-video: "";
    private property <string> draft-audio: "";
    private property <string> draft-muxed: "";

    // The height of the top bar, so that the host knows how much of the
    // window the video may use.
    out property <length> top-bar-height: Theme.bar-height;

    in property <bool> controls-visible: true;
    // Which of the three loading dots is lit up, from zero to two.
    in property <int> spinner-step: 0;

    private property <bool> can-apply: root.draft-video != ""
        || root.draft-audio != ""
        || root.draft-muxed != "";

    function open-sources() {
        root.draft-video = root.selected-video-id;
        root.draft-audio = root.selected-audio-id;
        root.draft-muxed = root.selected-muxed-id;
        root.sources-open = true;
    }

    function toggle-sources() {
        if (root.sources-open) {
            root.sources-open = false;
        } else {
            root.open-sources();
        }
    }

    function toggle-video(id: string) {
        root.draft-muxed = "";
        root.draft-video = root.draft-video == id ? "" : id;
    }

    function toggle-audio(id: string) {
        root.draft-muxed = "";
        root.draft-audio = root.draft-audio == id ? "" : id;
    }

    function toggle-muxed(id: string) {
        if (root.draft-muxed == id) {
            root.draft-muxed = "";
        } else {
            root.draft-muxed = id;
            root.draft-video = "";
            root.draft-audio = "";
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        moved => { root.pointer-activity(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
    }

    // Video area with status display
    VideoPlayer {
        x: 0;
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        container-height: parent.height - Theme.bar-height;
        status: root.status;
        status-kind: root.status-kind;
        spinner-step: root.spinner-step;
        has-media: root.has-media;
        controls-visible: root.controls-visible;
        pointer-activity => { root.pointer-activity(); }
    }

    // Video header (title and channel) overlay below top bar
    VideoHeader {
        x: 0;
        width: parent.width;
        title: root.media-title;
        uploader: root.media-uploader;
        has-media: root.has-media;
        controls-visible: root.controls-visible;
        pointer-activity => { root.pointer-activity(); }
    }

    // Top bar with URL field
    TopBar {
        x: 0;
        y: 0;
        width: parent.width;
        url <=> root.url;
        load-requested => { root.load-requested(); }
        pointer-activity => { root.pointer-activity(); }
    }

    // Control bar
    PlayerControls {
        x: 0;
        y: root.controls-visible ? parent.height - Theme.controls-height : parent.height;
        width: parent.width;
        height: Theme.controls-height;
        container-height: parent.height - Theme.bar-height;
        playing: root.playing;
        position: root.position;
        duration: root.duration;
        volume: root.volume;
        time-text: root.time-text;
        live: root.live;
        at-live-edge: root.at-live-edge;
        fullscreen: root.fullscreen;
        sources-open: root.sources-open;
        has-media: root.has-media;
        controls-visible: root.controls-visible;
        play-toggled => { root.play-toggled(); }
        seek-requested(value) => { root.seek-requested(value); }
        volume-requested(value) => { root.volume-requested(value); }
        volume-toggled => { root.volume-toggled(); }
        fullscreen-toggled => { root.fullscreen-toggled(); }
        live-requested => { root.live-requested(); }
        pointer-activity => { root.pointer-activity(); }
        controls-hovered(hovered) => { root.controls-hovered(hovered); }
        interacting-changed(interacting) => { root.interacting-changed(interacting); }
        sources-toggled => { root.toggle-sources(); }
    }

    // Toast notification
    Toast {
        toast-text: root.toast-text;
        toast-visible: root.toast-visible;
        controls-height: Theme.controls-height;
    }

    // Source picker
    if root.sources-open: SourcePicker {
        width: parent.width;
        height: parent.height;
        video-sources: root.video-sources;
        audio-sources: root.audio-sources;
        muxed-sources: root.muxed-sources;
        selected-video-id <=> root.draft-video;
        selected-audio-id <=> root.draft-audio;
        selected-muxed-id <=> root.draft-muxed;
        sources-open <=> root.sources-open;
        sources-applied(v, a, m) => {
            root.selected-video-id = v;
            root.selected-audio-id = a;
            root.selected-muxed-id = m;
            root.sources-applied(v, a, m);
        }
        pointer-activity => { root.pointer-activity(); }
    }

    // Pending dialog
    if root.pending-open: PendingDialog {
        width: parent.width;
        height: parent.height;
        pending-title: root.pending-title;
        pending-thumbnail: root.pending-thumbnail;
        pending-open <=> root.pending-open;
        pending-play-requested => { root.pending-play-requested(); }
        pending-queue-requested => { root.pending-queue-requested(); }
        pending-dismissed => { root.pending-dismissed(); }
    }

    if root.update-open: Rectangle {
        width: parent.width; height: parent.height;
        background: #00000099;
        Rectangle {
            x: (parent.width - min(560px, parent.width - 40px)) / 2;
            y: (parent.height - min(440px, parent.height - 40px)) / 2;
            width: min(560px, parent.width - 40px); height: min(440px, parent.height - 40px);
            background: Theme.panel; border-radius: 12px; border-width: 1px; border-color: Theme.border;
            VerticalLayout {
                padding: 22px; spacing: 12px;
                Text { text: root.update-installing ? "Installing update…" : "Flatline update available"; color: Theme.fg; font-size: 20px; }
                Text { text: "Version " + root.update-version; color: Theme.muted; }
                ScrollView { height: 260px; Text { text: root.update-notes; color: Theme.fg; wrap: word-wrap; } }
                if root.update-error != "": Text { text: root.update-error; color: Theme.danger; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    if !root.update-installing && root.update-error == "": Button { text: "No"; clicked => { root.update-open = false; root.update-dismissed(); } }
                    if !root.update-installing && root.update-error == "": Button { text: "Yes, download and install"; clicked => { root.update-installing = true; root.update-accepted(); } }
                    if root.update-installing: ProgressIndicator { indeterminate: true; }
                    if root.update-error != "": Button { text: "Close"; clicked => { root.update-open = false; root.update-dismissed(); } }
                }
            }
        }
    }
}
