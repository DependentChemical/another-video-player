import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FlatButton, FullscreenButton, GearButton, LiveButton, PlayPauseButton, SeekBar, VolumeIcon, VolumeOffIcon } from "widgets.slint";

/// One row of the source picker.
export struct StreamItem {
    id: string,
    label: string,
    detail: string,
}

// One column of the source picker.
//
// A row toggles its stream; the selected row is highlighted and the picker
// turns the three columns into one selection when the user applies it.
component SourceColumn inherits Rectangle {
    in property <string> heading: "";
    in property <[StreamItem]> items: [];
    in property <string> selected: "";
    callback picked(string);

    background: transparent;

    VerticalLayout {
        spacing: 6px;

        Text {
            height: 18px;
            text: root.heading;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.elevated;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    if root.items.length == 0: Text {
                        height: 36px;
                        text: "None available";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    for item in root.items: Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: touch.pressed
                            ? Theme.border
                            : (root.selected == item.id ? #4c8bf540 : transparent);

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                height: 16px;
                                text: item.label;
                                color: root.selected == item.id ? Theme.accent : Theme.fg;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                height: 14px;
                                text: item.detail;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        touch := TouchArea {
                            clicked => {
                                root.picked(item.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// The shell of the player: a URL bar on top, the video below it.
//
// The video itself is *not* drawn here. mpv draws it into the lower part of
// the window before Slint renders this scene, and every part of the scene
// that stays transparent lets that frame through.
export component MainWindow inherits Window {
    title: root.has-media ? root.media-title + " — Flatline" : "Flatline";
    preferred-width: 1100px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 340px;
    background: root.has-media ? transparent : Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    // ------------------------------------------------------------- state --
    in-out property <string> url: "";
    in property <string> media-title: "";
    in property <string> status: "";
    // "info", "busy" or "error".
    in property <string> status-kind: "info";
    // The streams the source offers, split into the three picker columns.
    in property <[StreamItem]> video-sources: [];
    in property <[StreamItem]> audio-sources: [];
    in property <[StreamItem]> muxed-sources: [];
    // The streams that are currently playing.
    in-out property <string> selected-video-id: "";
    in-out property <string> selected-audio-id: "";
    in-out property <string> selected-muxed-id: "";
    // Whether the source picker is open. The host closes it on a new load.
    in-out property <bool> sources-open: false;
    in property <bool> has-media: false;
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 100;
    // The playback position, formatted for the user.
    in property <string> time-text: "0:00 / 0:00";
    // Whether the media is a live stream.
    in property <bool> live: false;
    // Whether the playback is at the live edge.
    in property <bool> at-live-edge: true;
    // Whether the window is in full screen.
    in property <bool> fullscreen: false;

    // ------------------------------------------------------------ events --
    callback load-requested();
    callback sources-applied(string, string, string);
    callback play-toggled();
    callback seek-requested(float);
    callback volume-requested(float);
    callback volume-toggled();
    callback fullscreen-toggled();
    callback live-requested();
    callback pointer-activity();

    // --------------------------------------------------------- internals --
    // The picker edits a draft, so cancelling leaves the playing selection
    // untouched.
    private property <string> draft-video: "";
    private property <string> draft-audio: "";
    private property <string> draft-muxed: "";

    // The height of the top bar, so that the host knows how much of the
    // window the video may use.
    out property <length> top-bar-height: Theme.bar-height;

    in property <bool> controls-visible: true;
    // Which of the three loading dots is lit up, from zero to two.
    in property <int> spinner-step: 0;

    private property <bool> can-apply: root.draft-video != ""
        || root.draft-audio != ""
        || root.draft-muxed != "";

    function open-sources() {
        root.draft-video = root.selected-video-id;
        root.draft-audio = root.selected-audio-id;
        root.draft-muxed = root.selected-muxed-id;
        root.sources-open = true;
    }

    function toggle-sources() {
        if (root.sources-open) {
            root.sources-open = false;
        } else {
            root.open-sources();
        }
    }

    function toggle-video(id: string) {
        root.draft-muxed = "";
        root.draft-video = root.draft-video == id ? "" : id;
    }

    function toggle-audio(id: string) {
        root.draft-muxed = "";
        root.draft-audio = root.draft-audio == id ? "" : id;
    }

    function toggle-muxed(id: string) {
        if (root.draft-muxed == id) {
            root.draft-muxed = "";
        } else {
            root.draft-muxed = id;
            root.draft-video = "";
            root.draft-audio = "";
        }
    }

    TouchArea {
        width: parent.width;
        height: parent.height;
        moved => { root.pointer-activity(); }
        pointer-event(event) => {
            if event.kind == PointerEventKind.move { root.pointer-activity(); }
        }
    }

    // --------------------------------------------------------- top bar ----
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: Theme.bar-height;
        background: Theme.panel;

        Text {
            x: 16px;
            width: 72px;
            text: "Flatline";
            color: Theme.fg;
            font-size: 15px;
            vertical-alignment: center;
        }

        url-field := Rectangle {
            x: 96px;
            y: (parent.height - 32px) / 2;
            width: parent.width - 96px - 68px;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: url-input.has-focus ? Theme.accent : Theme.border;
            background: Theme.elevated;

            url-placeholder := Text {
                x: 10px;
                text: "Paste a video URL and press Enter";
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
                visible: url-input.text == "";
            }

            url-input := TextInput {
                x: 10px;
                y: 0px;
                width: parent.width - 20px;
                height: parent.height;
                text <=> root.url;
                color: Theme.fg;
                font-size: 13px;
                vertical-alignment: center;
                accepted => {
                    root.load-requested();
                }
            }
        }

        load-button := FlatButton {
            x: parent.width - 56px;
            y: (parent.height - 32px) / 2;
            width: 40px;
            height: 32px;
            label: "Go";
            primary: true;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.load-requested();
            }
        }
    }

    // ------------------------------------------------------- video area ----
    Rectangle {
        x: 0px;
        y: Theme.bar-height;
        width: parent.width;
        height: parent.height - Theme.bar-height;
        background: transparent;

        TouchArea {
            width: parent.width;
            height: parent.height;
            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    root.pointer-activity();
                }
            }
            moved => { root.pointer-activity(); }
        }

        // A centred message, used for errors and for hints.
        Rectangle {
            x: 0px;
            y: (parent.height - 48px) / 2;
            width: parent.width;
            height: 48px;

            // Three dots that take turns lighting up while the player waits.
            if root.status-kind == "busy": Rectangle {
                x: (parent.width - 40px) / 2;
                y: parent.height / 2 - 16px;
                width: 40px;
                height: 8px;

                Rectangle {
                    x: 0px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 0 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }

                Rectangle {
                    x: 16px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 1 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }

                Rectangle {
                    x: 32px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 2 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }
            }

            Text {
                width: parent.width;
                y: root.status-kind == "busy" ? parent.height / 2 + 8px : 0px;
                height: root.status-kind == "busy" ? 24px : parent.height;
                text: root.status;
                color: root.status-kind == "error" ? Theme.danger : Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // The control bar, floating over the video.
        Rectangle {
            x: 0px;
            y: root.controls-visible ? parent.height - Theme.controls-height : parent.height;
            width: parent.width;
            height: Theme.controls-height;
            background: #000000a6;
            opacity: root.controls-visible ? 1 : 0;
            animate y { duration: 180ms; easing: ease-out; }
            animate opacity { duration: 140ms; }

            PlayPauseButton {
                x: 12px;
                y: (parent.height - 32px) / 2;
                width: 44px;
                height: 32px;
                playing: root.playing;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.play-toggled();
                }
            }

            // The live button is only there while a live stream plays.
            LiveButton {
                x: 60px;
                y: (parent.height - 32px) / 2;
                width: 82px;
                height: 32px;
                visible: root.live;
                at-edge: root.at-live-edge;
                label: root.time-text;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.live-requested();
                }
            }

            Text {
                x: 68px;
                width: 64px;
                visible: !root.live;
                text: root.time-text;
                color: Theme.fg;
                font-size: 12px;
                vertical-alignment: center;
            }

            seek := SeekBar {
                x: root.live ? 152px : 140px;
                y: (parent.height - 18px) / 2;
                width: parent.width - (root.live ? 152px : 140px) - 220px;
                height: 18px;
                value: root.position;
                maximum: root.duration;
                pointer-activity => { root.pointer-activity(); }
                moved(value) => {
                    root.seek-requested(value);
                }
            }

            GearButton {
                x: parent.width - 212px;
                y: (parent.height - 32px) / 2;
                width: 32px;
                height: 32px;
                active: root.sources-open;
                enabled: root.has-media;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.toggle-sources();
                }
            }

            Rectangle {
                x: parent.width - 40px - 90px - 20px - 26px;
                y: (parent.height - 24px) / 2;
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: volume-touch.pressed ? Theme.elevated : transparent;

                if root.volume <= 0: VolumeOffIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if root.volume > 0: VolumeIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                volume-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move { root.pointer-activity(); }
                    }
                    clicked => {
                        root.volume-toggled();
                    }
                }
            }

            volume := SeekBar {
                x: parent.width - 40px - 90px - 20px;
                y: (parent.height - 18px) / 2;
                width: 90px;
                height: 18px;
                value: root.volume;
                maximum: 200;
                moved(value) => {
                    root.volume-requested(value);
                }
            }

            FullscreenButton {
                x: parent.width - 40px - 12px;
                y: (parent.height - 32px) / 2;
                width: 40px;
                height: 32px;
                fullscreen: root.fullscreen;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.fullscreen-toggled();
                }
            }
        }
    }

    // --------------------------------------------------- source picker ----
    if root.sources-open: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000066;

        TouchArea {
            clicked => {
                root.sources-open = false;
            }
        }

        panel := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 40px, 820px);
            height: min(parent.height - 40px, 440px);
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000c0;

            // Keep clicks on the panel from reaching the backdrop.
            TouchArea { }

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: "Sources";
                        color: Theme.fg;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: "Pick a video and an audio track, or one combined stream.";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;

                    SourceColumn {
                        heading: "Video only";
                        items: root.video-sources;
                        selected: root.draft-video;
                        picked(id) => {
                            root.toggle-video(id);
                        }
                    }

                    SourceColumn {
                        heading: "Audio only";
                        items: root.audio-sources;
                        selected: root.draft-audio;
                        picked(id) => {
                            root.toggle-audio(id);
                        }
                    }

                    SourceColumn {
                        heading: "Video + audio";
                        items: root.muxed-sources;
                        selected: root.draft-muxed;
                        picked(id) => {
                            root.toggle-muxed(id);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1;
                        text: "Selecting a combined stream clears the other two columns.";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }

                    FlatButton {
                        width: 80px;
                        height: 30px;
                        label: "Cancel";
                        clicked => {
                            root.sources-open = false;
                        }
                    }

                    FlatButton {
                        width: 80px;
                        height: 30px;
                        label: "Apply";
                        primary: true;
                        enabled: root.can-apply;
                        clicked => {
                            root.selected-video-id = root.draft-video;
                            root.selected-audio-id = root.draft-audio;
                            root.selected-muxed-id = root.draft-muxed;
                            root.sources-applied(
                                root.draft-video,
                                root.draft-audio,
                                root.draft-muxed
                            );
                            root.sources-open = false;
                        }
                    }
                }
            }
        }
    }
}
