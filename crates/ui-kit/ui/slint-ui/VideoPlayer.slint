import { Theme } from "../theme.slint";

export component VideoPlayer inherits Rectangle {
    in property <string> status: "";
    in property <string> status-kind: "info";
    in property <int> spinner-step: 0;
    in property <bool> has-media: false;
    in property <bool> controls-visible: true;
    in property <length> container-height: 0;
    callback pointer-activity();

    background: transparent;

    TouchArea {
        width: root.width;
        height: root.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-activity();
            }
        }
        moved => { root.pointer-activity(); }
    }

    Rectangle {
        width: root.width;
        height: root.container-height;

        if root.status-kind == "busy": VerticalLayout {
            alignment: center;
            spacing: 16px;

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 0 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 1 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                    opacity: root.spinner-step == 2 ? 1.0 : 0.3;
                    animate opacity { duration: 160ms; }
                }
            }

            Text {
                text: root.status;
                color: root.status-kind == "error" ? Theme.danger : Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.status-kind != "busy": VerticalLayout {
            alignment: center;

            Text {
                text: root.status;
                color: root.status-kind == "error" ? Theme.danger : Theme.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
