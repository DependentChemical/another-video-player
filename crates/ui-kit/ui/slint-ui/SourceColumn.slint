import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { StreamItem } from "types.slint";

// One column of the source picker.
//
// A row toggles its stream; the selected row is highlighted and the picker
// turns the three columns into one selection when the user applies it.
export component SourceColumn inherits Rectangle {
    in property <string> heading: "";
    in property <[StreamItem]> items: [];
    in property <string> selected: "";
    callback picked(string);

    background: transparent;

    VerticalLayout {
        spacing: 6px;

        Text {
            height: 18px;
            text: root.heading;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }

        Rectangle {
            vertical-stretch: 1;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.elevated;
            clip: true;

            ScrollView {
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    if root.items.length == 0: Text {
                        height: 36px;
                        text: "None available";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    for item in root.items: Rectangle {
                        height: 44px;
                        border-radius: 4px;
                        background: touch.pressed
                            ? Theme.border
                            : (root.selected == item.id ? #4c8bf540 : transparent);

                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 1px;
                            alignment: center;

                            Text {
                                height: 16px;
                                text: item.label;
                                color: root.selected == item.id ? Theme.accent : Theme.fg;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                height: 14px;
                                text: item.detail;
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        touch := TouchArea {
                            clicked => {
                                root.picked(item.id);
                            }
                        }
                    }
                }
            }
        }
    }
}