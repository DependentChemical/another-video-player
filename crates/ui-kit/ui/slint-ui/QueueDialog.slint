import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import {
    CloseButton, FlatButton, Icon, PlayIcon, MoreIcon, ContentCopyIcon, RefreshIcon, DeleteIcon
} from "../widgets.slint";
import { PlaylistItem, QueueItem } from "types.slint";

// The list of the active playlist, shown from the sidebar.
export component QueueDialog inherits Rectangle {
    in-out property <bool> open: false;
    // "Queue" for the built-in queue, "Queue [name]" for a user playlist.
    in property <string> title: "Queue";
    in property <[QueueItem]> items: [];
    in property <int> current-index: -1;
    in property <int> current-id: -1;
    in property <int> long-press-index: -1;
    // Whether the list belongs to a user playlist rather than the queue.
    in property <bool> in-playlist: false;
    in property <[PlaylistItem]> playlists: [];
    in-out property <length> queue-content-y: 0px;
    // The absolute (window) y of the pointer during a drag. Kept by the
    // dragged row itself because Slint only updates the grabbed `TouchArea`
    // while the button is held, never its siblings. Absolute coordinates are
    // used so the value stays valid no matter how far the list scrolls.
    in-out property <length> drag-pointer-y: 0px;
    // Toggled by the host every 16ms while a drag is active. The `changed`
    // handler runs the auto-scroll with direct access to the scroll view's
    // real geometry, so no height has to be reported to the host.
    in property <bool> drag-scroll-tick: false;
    in-out property <bool> menu-open: false;
    in-out property <string> menu-url: "";
    in-out property <int> menu-entry-id: -1;
    private property <bool> picker-open: false;
    private property <bool> picker-moves: false;
    callback item-selected(int);
    callback copy-url(string);
    callback refresh-sources(int);
    callback remove-entry(int);
    callback move-requested(int, int);
    callback queue-row-pressed(int);
    callback queue-row-released(int);
    callback add-to-playlist(int, string);
    callback move-to-playlist(int, string);
    callback add-to-new-playlist(int);
    callback move-to-new-playlist(int);
    callback dismissed();

    private property <length> row-spacing: 4px;
    private property <length> row-step: root.row-height + root.row-spacing;
    private property <length> button-size: 32px;
    private property <length> menu-anchor-x: 0px;
    private property <length> menu-anchor-y: 0px;

    // The fixed height of a queue row. It accommodates up to two wrapped
    // title lines and one uploader line, with overflow truncated.
    private property <length> row-height: 76px;

    // The row the pointer would drop onto, in the list's content space. The
    // pointer is stored in window coordinates, so subtract the content
    // element's window position (scroll view top plus the current scroll) to
    // get the content-space offset. Re-evaluated as the list scrolls under a
    // stationary pointer, which keeps the drop indicator correct.
    private property <int> drag-target: root.long-press-index < 0
        ? -1
        : clamp(floor((root.drag-pointer-y
                - (scroll-view.absolute-position.y + root.queue-content-y))
                / root.row-step),
            0, root.items.length - 1);

    changed drag-scroll-tick => {
        root.auto-scroll();
    }

    background: #00000088;

    changed open => {
        if !self.open {
            self.menu-open = false;
            self.picker-open = false;
            self.picker-moves = false;
        }
    }

    TouchArea {
        clicked => {
            root.open = false;
            root.dismissed();
        }
    }

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 40px, 560px);
        height: min(root.height - 40px, 560px);
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;

        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: root.title;
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                CloseButton {
                    clicked => {
                        root.open = false;
                        root.dismissed();
                    }
                }
            }

            // Always created so its real geometry is available to the
            // auto-scroll; hidden when the queue is empty.
            scroll-view := ScrollView {
                vertical-stretch: 1;
                content-y <=> queue-content-y;
                visible: root.items.length > 0;

                VerticalLayout {
                    spacing: root.row-spacing;
                    padding-right: 12px;

                    if root.items.length == 0: Text {
                        text: "The queue is empty.";
                        color: Theme.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    for item in root.items: row := Rectangle {
                        // The row has a fixed height so drag targeting and
                        // scrolling can use the same constant again; the text
                        // truncates beyond the generous content allowance.
                        height: root.row-height;
                        border-radius: 8px;
                        background: item.current
                            ? Theme.elevated
                            : ((item.index == root.long-press-index)
                                ? #00000033
                                : ((row-touch.has-hover || option-touch.has-hover || delete-touch.has-hover)
                                    ? Theme.elevated
                                    : transparent));

                        // The row is a vertical stack so a drop indicator, when
                        // shown, takes its own line. The content area below it
                        // stretches to fill whatever height is left and centers
                        // the row, so the row looks identical to before the bar
                        // appears.
                        VerticalLayout {
                            spacing: 0;

                            // A row dragged upwards lands before its target, so
                            // the bar is drawn above the content.
                            if root.drag-target == item.index
                                && root.long-press-index > root.drag-target: Rectangle {
                                height: 3px;
                                background: Theme.accent;
                            }

                            VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    // The whole row except the buttons opens the
                                    // entry. A short press plays it; a long press
                                    // (750ms, tracked by `long-press-index`) starts a
                                    // drag instead.
                                    clickable := Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        background: transparent;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            cross-axis-alignment: center;

                                            // A fixed slot keeps the thumbnails of all
                                            // rows aligned while only the current row
                                            // shows the play marker.
                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                background: transparent;

                                                if item.current: PlayIcon {
                                                    width: 16px;
                                                    height: 16px;
                                                    ink: Theme.accent;
                                                }
                                            }

                                            Rectangle {
                                                width: 96px;
                                                height: 54px;
                                                border-radius: 6px;
                                                background: #00000040;
                                                clip: true;

                                                Image {
                                                    width: 100%;
                                                    height: 100%;
                                                    source: item.thumbnail;
                                                    image-fit: cover;
                                                }
                                            }

                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                spacing: 2px;
                                                alignment: center;

                                                Text {
                                                    text: item.title;
                                                    color: Theme.fg;
                                                    font-size: 13px;
                                                    wrap: word-wrap;
                                                    max-lines: 2;
                                                    overflow: clip;
                                                    min-width: 0px;
                                                }

                                                Text {
                                                    text: item.uploader;
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                    max-lines: 1;
                                                    overflow: clip;
                                                }
                                            }
                                        }

                                        row-touch := TouchArea {
                                            // The grabbed TouchArea is the only
                                            // one Slint keeps updating while the
                                            // button is held, so the drag position
                                            // has to come from here. Its absolute
                                            // position plus the local pointer is
                                            // the pointer in window coordinates.
                                            moved => {
                                                root.drag-pointer-y = self.absolute-position.y
                                                    + self.mouse-y;
                                            }
                                            changed pressed => {
                                                root.drag-pointer-y = self.absolute-position.y
                                                    + self.mouse-y;
                                                if self.pressed {
                                                    root.queue-row-pressed(item.index);
                                                } else {
                                                    // A drag commits wherever the
                                                    // pointer is released, even
                                                    // outside the grabbed row;
                                                    // that is the whole point of
                                                    // the auto-scroll. A short
                                                    // press only plays when it is
                                                    // released over the row.
                                                    if root.long-press-index >= 0 {
                                                        root.commit_move();
                                                    } else if self.has-hover {
                                                        root.open = false;
                                                        root.item-selected(item.id);
                                                    }
                                                    root.queue-row-released(item.index);
                                                }
                                            }
                                        }
                                    }

                                    // The button set is its own fixed column, so every
                                    // row lines its buttons up on the same right edge.
                                    HorizontalLayout {
                                        horizontal-stretch: 0;
                                        spacing: 4px;
                                        alignment: end;
                                        cross-axis-alignment: center;

                                        // More options button (three dots)
                                        option-button := Rectangle {
                                            width: root.button-size;
                                            height: root.button-size;
                                            border-radius: 6px;
                                            background: option-touch.has-hover ? Theme.elevated : transparent;

                                            MoreIcon {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                ink: option-touch.has-hover ? Theme.fg : Theme.muted;
                                            }

                                            option-touch := TouchArea {
                                                clicked => {
                                                    root.menu-anchor-x = option-button.absolute-position.x
                                                        - panel.absolute-position.x + option-button.width;
                                                    root.menu-anchor-y = option-button.absolute-position.y
                                                        - panel.absolute-position.y + option-button.height + 4px;
                                                    root.menu-open = true;
                                                    root.menu-url = item.url;
                                                    root.menu-entry-id = item.id;
                                                }
                                            }
                                        }

                                        // Delete button
                                        delete-button := Rectangle {
                                            width: root.button-size;
                                            height: root.button-size;
                                            border-radius: 6px;
                                            background: delete-touch.has-hover ? Theme.danger : transparent;

                                            DeleteIcon {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                ink: delete-touch.has-hover ? Theme.on-accent : Theme.muted;
                                            }

                                            delete-touch := TouchArea {
                                                clicked => {
                                                    root.remove-entry(item.id);
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // A row dragged downwards lands after its target, so
                            // the bar is drawn below the content.
                            if root.drag-target == item.index
                                && root.long-press-index < root.drag-target: Rectangle {
                                height: 3px;
                                background: Theme.accent;
                            }
                        }
                    }
                }
            }
        }

        // The menu overlay sits on top of the panel, so a click anywhere else
        // closes the menu. The menu is positioned from the button that opened
        // it, like a regular popup, and sized to its contents.
        if root.menu-open: Rectangle {
            width: panel.width;
            height: panel.height;
            background: transparent;

            overlay-touch := TouchArea {
                clicked => {
                    root.open = false;
                }
            }

            menu := Rectangle {
                x: min(max(8px, root.menu-anchor-x - self.width),
                    panel.width - self.width - 8px);
                y: min(root.menu-anchor-y, panel.height - self.height - 8px);
                width: menu-layout.preferred-width;
                height: menu-layout.preferred-height;
                background: Theme.panel;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000080;

                menu-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;

                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: menu-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;

                            ContentCopyIcon {
                                ink: menu-touch.has-hover ? Theme.accent : Theme.muted;
                            }
                            Text {
                                text: "Copy URL";
                                color: Theme.fg;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                            }
                        }

                        menu-touch := TouchArea {
                            clicked => {
                                root.copy-url(root.menu-url);
                                root.menu-open = false;
                            }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: refresh-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;

                            RefreshIcon {
                                ink: refresh-touch.has-hover ? Theme.accent : Theme.muted;
                            }
                            Text {
                                text: "Refresh Sources";
                                color: Theme.fg;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                            }
                        }

                        refresh-touch := TouchArea {
                            clicked => {
                                root.refresh-sources(root.menu-entry-id);
                                root.menu-open = false;
                            }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: playlist-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;

                            Icon {
                                glyph: "\u{e405}";
                                size: 16px;
                                ink: playlist-touch.has-hover ? Theme.accent : Theme.muted;
                            }
                            Text {
                                text: root.in-playlist ? "Add to Another Playlist" : "Add to Playlist";
                                color: Theme.fg;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                            }
                        }

                        playlist-touch := TouchArea {
                            clicked => {
                                root.menu-open = false;
                                root.picker-moves = false;
                                root.picker-open = true;
                            }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: move-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;

                            Icon {
                                glyph: "\u{e405}";
                                size: 16px;
                                ink: move-touch.has-hover ? Theme.accent : Theme.muted;
                            }
                            Text {
                                text: root.in-playlist ? "Move to Another Playlist" : "Move to Playlist";
                                color: Theme.fg;
                                font-size: 13px;
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                            }
                        }

                        move-touch := TouchArea {
                            clicked => {
                                root.menu-open = false;
                                root.picker-moves = true;
                                root.picker-open = true;
                            }
                        }
                    }
                }
            }
        }

        // The playlist picker sits above the row menu and asks where the
        // current row should be added or moved. Outside clicks cancel it.
        if root.picker-open: Rectangle {
            width: panel.width;
            height: panel.height;
            background: #00000066;

            TouchArea {
                clicked => {
                    root.picker-open = false;
                }
            }

            picker := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, 360px);
                height: min(parent.height - 40px, 420px);
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.panel;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000c0;

                TouchArea { }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: root.picker-moves ? "Move to Playlist" : "Add to Playlist";
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 4px;
                            padding-right: 10px;

                            for playlist in root.playlists: Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: picker-touch.has-hover && (!root.picker-moves || !playlist.active)
                                    ? Theme.elevated
                                    : transparent;

                                HorizontalLayout {
                                    alignment: start;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: playlist.name;
                                        color: root.picker-moves && playlist.active ? Theme.muted : Theme.fg;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: left;
                                    }
                                }

                                picker-touch := TouchArea {
                                    clicked => {
                                        if !root.picker-moves || !playlist.active {
                                            root.picker-open = false;
                                            if root.picker-moves {
                                                root.move-to-playlist(root.menu-entry-id, playlist.id);
                                            } else {
                                                root.add-to-playlist(root.menu-entry-id, playlist.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    FlatButton {
                        height: 32px;
                        label: root.picker-moves ? "Move to New Playlist" : "Add to New Playlist";
                        primary: true;
                        clicked => {
                            root.picker-open = false;
                            if root.picker-moves {
                                root.move-to-new-playlist(root.menu-entry-id);
                            } else {
                                root.add-to-new-playlist(root.menu-entry-id);
                            }
                        }
                    }

                    FlatButton {
                        height: 32px;
                        label: "Cancel";
                        clicked => {
                            root.picker-open = false;
                        }
                    }
                }
            }
        }
    }

    // Scroll the list while a row is dragged towards the top or bottom of the
    // visible area. The step grows with the square of the distance past the
    // trigger edge, so the farther the pointer is pushed the faster it scrolls.
    // Everything is read from the scroll view's live geometry, which makes the
    // direction and clamping exact regardless of layout timing.
    function auto-scroll() {
        if root.long-press-index < 0 {
            return;
        }
        let viewport-height = scroll-view.height;
        if viewport-height <= 0px {
            return;
        }
        let pointer = root.drag-pointer-y - scroll-view.absolute-position.y;
        // A trigger band on each side, at most a third of the viewport.
        let threshold = min(viewport-height / 3, 96px);
        let step = max(8px, viewport-height * 0.06);
        let lowest = min(viewport-height - scroll-view.content-height, 0px);

        if pointer < threshold && root.queue-content-y < 0px {
            let t = clamp((threshold - pointer) / threshold, 0.0, 1.0);
            root.queue-content-y = min(0px, root.queue-content-y + step * t * t);
        }

        if pointer > viewport-height - threshold && root.queue-content-y > lowest {
            let t = clamp((pointer - (viewport-height - threshold)) / threshold, 0.0, 1.0);
            root.queue-content-y = max(lowest, root.queue-content-y - step * t * t);
        }
    }

    // Commit the move: hand the source/target indices to the host, which
    // rebuilds the id order in the active playlist and repaints the queue.
    function commit_move() {
        let source = root.long-press-index;
        let target = root.drag-target;
        if source < 0 || target < 0 || source == target { return; }
        root.move-requested(source, target);
    }
}
