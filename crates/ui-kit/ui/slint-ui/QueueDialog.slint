import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CloseButton } from "../widgets.slint";
import { QueueItem } from "types.slint";

// The list of the active queue, shown from the sidebar.
export component QueueDialog inherits Rectangle {
    in-out property <bool> open: false;
    in property <[QueueItem]> items: [];
    callback item-selected(int);
    callback dismissed();

    background: #00000088;

    TouchArea {
        clicked => {
            root.open = false;
            root.dismissed();
        }
    }

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 40px, 560px);
        height: min(root.height - 40px, 560px);
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;

        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Queue";
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                CloseButton {
                    clicked => {
                        root.open = false;
                        root.dismissed();
                    }
                }
            }

            if root.items.length == 0: Text {
                text: "The queue is empty.";
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }

            if root.items.length > 0: ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;

                    for item in root.items: Rectangle {
                        height: 76px;
                        border-radius: 8px;
                        background: item.current ? Theme.elevated : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: start;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 96px;
                                height: 54px;
                                border-radius: 6px;
                                background: #00000040;
                                clip: true;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: item.thumbnail;
                                    image-fit: cover;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;

                                Text {
                                    height: 34px;
                                    text: item.title;
                                    color: Theme.fg;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    height: 16px;
                                    text: item.uploader;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }

                            if item.current: Text {
                                text: "Playing";
                                color: Theme.accent;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            clicked => {
                                root.open = false;
                                root.item-selected(item.position);
                            }
                        }
                    }
                }
            }
        }
    }
}
