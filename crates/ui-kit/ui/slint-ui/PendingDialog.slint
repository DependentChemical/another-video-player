import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CloseButton, FlatButton, MoreIcon } from "../widgets.slint";
import { PlaylistItem } from "types.slint";

export component PendingDialog inherits Rectangle {
    in property <string> pending-title: "";
    in property <image> pending-thumbnail;
    // Whether a user playlist is the active playlist rather than the queue.
    in property <bool> in-playlist: false;
    in property <bool> pending-is-playlist: false;
    // Whether the playlist URL also selected a specific video.
    in property <bool> pending-has-selected-video: false;
    in property <int> pending-playlist-count: 0;
    in property <[PlaylistItem]> playlists: [];
    in-out property <bool> pending-open: false;
    callback pending-play-requested();
    callback pending-queue-requested();
    callback pending-queue-next-requested();
    callback pending-add-to-playlist(string);
    callback pending-add-to-new-playlist();
    callback pending-play-selected-requested();
    callback pending-play-playlist-requested();
    callback pending-play-playlist-new-requested();
    callback pending-append-playlist(string);
    callback pending-append-playlist-new();
    callback pending-dismissed();

    private property <bool> options-open: false;
    private property <bool> picker-open: false;
    private property <bool> picker-append: false;
    private property <length> menu-anchor-x: 0px;
    private property <length> menu-anchor-y: 0px;

    changed pending-open => {
        if !self.pending-open {
            self.options-open = false;
            self.picker-open = false;
            self.picker-append = false;
        }
    }

    background: #00000088;

    TouchArea {
        clicked => {
            root.pending-open = false;
            root.pending-dismissed();
        }
    }

    pending-panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 40px, 460px);
        height: min(root.height - 40px, 440px);
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;

        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "New Video";
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                CloseButton {
                    clicked => {
                        root.pending-open = false;
                        root.pending-dismissed();
                    }
                }
            }

            Rectangle {
                height: 200px;
                border-radius: 8px;
                background: Theme.elevated;
                clip: true;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.pending-thumbnail;
                    image-fit: contain;
                }
            }

            Text {
                text: root.pending-title;
                color: Theme.fg;
                font-size: 15px;
                font-weight: 600;
                wrap: word-wrap;
                max-lines: 4;
                overflow: clip;
                vertical-alignment: center;
            }

            Text {
                text: root.pending-is-playlist
                    ? (root.pending-has-selected-video
                        ? "What do you want to do with this video or playlist?"
                        : "What do you want to do with this playlist?")
                    : "What do you want to do with this video?";
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                if root.pending-is-playlist: split-button-playlist := Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    clip: true;
                    background: Theme.accent;

                    HorizontalLayout {
                        spacing: 0px;

                        Rectangle {
                            width: 130px;
                            background: left-playlist-touch.pressed ? #5a9bf5 : (left-playlist-touch.has-hover ? #5a9bf5 : Theme.accent);

                            Text {
                                text: "Play Playlist";
                                color: Theme.on-accent;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            left-playlist-touch := TouchArea {
                                clicked => {
                                    root.options-open = false;
                                    root.pending-open = false;
                                    root.pending-play-playlist-requested();
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: #ffffff33;
                        }

                        Rectangle {
                            width: 34px;
                            background: right-playlist-touch.pressed ? #5a9bf5 : (right-playlist-touch.has-hover ? #5a9bf5 : Theme.accent);

                            MoreIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                ink: Theme.on-accent;
                            }

                            right-playlist-touch := TouchArea {
                                clicked => {
                                    root.menu-anchor-x = split-button-playlist.absolute-position.x - pending-panel.absolute-position.x;
                                    root.menu-anchor-y = split-button-playlist.absolute-position.y - pending-panel.absolute-position.y + split-button-playlist.height + 2px;
                                    root.options-open = !root.options-open;
                                }
                            }
                        }
                    }
                }

                if !root.pending-is-playlist || root.pending-has-selected-video: split-button := Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    background: Theme.panel;

                    HorizontalLayout {
                        spacing: 0px;

                        Rectangle {
                            width: 130px;
                            background: left-touch.pressed ? Theme.elevated : (left-touch.has-hover ? Theme.elevated : Theme.panel);

                            Text {
                                text: root.in-playlist ? "Add to playlist" : "Add to queue";
                                color: Theme.fg;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            left-touch := TouchArea {
                                clicked => {
                                    root.options-open = false;
                                    if root.in-playlist {
                                        root.picker-append = false;
                                        root.picker-open = true;
                                    } else {
                                        root.pending-open = false;
                                        root.pending-queue-requested();
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: Theme.border;
                        }

                        Rectangle {
                            width: 34px;
                            background: right-touch.pressed ? Theme.elevated : (right-touch.has-hover ? Theme.elevated : Theme.panel);

                            MoreIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 18px;
                                ink: right-touch.has-hover ? Theme.fg : Theme.muted;
                            }

                            right-touch := TouchArea {
                                clicked => {
                                    root.menu-anchor-x = split-button.absolute-position.x - pending-panel.absolute-position.x;
                                    root.menu-anchor-y = split-button.absolute-position.y - pending-panel.absolute-position.y + split-button.height + 2px;
                                    root.options-open = !root.options-open;
                                }
                            }
                        }
                    }
                }

                if !root.pending-is-playlist || root.pending-has-selected-video: FlatButton {
                    width: 110px;
                    height: 34px;
                    label: "Play now";
                    primary: true;
                    clicked => {
                        root.options-open = false;
                        root.pending-open = false;
                        if root.pending-is-playlist {
                            root.pending-play-selected-requested();
                        } else {
                            root.pending-play-requested();
                        }
                    }
                }
            }
        }

        if root.options-open: Rectangle {
            x: 0;
            y: 0;
            width: pending-panel.width;
            height: pending-panel.height;
            background: transparent;

            TouchArea {
                clicked => {
                    root.options-open = false;
                }
            }

            Rectangle {
                x: min(max(8px, root.menu-anchor-x), pending-panel.width - self.width - 8px);
                y: root.menu-anchor-y;
                width: menu-layout.preferred-width;
                height: menu-layout.preferred-height;
                background: Theme.panel;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000080;

                menu-layout := VerticalLayout {
                    padding: 4px;
                    spacing: 2px;

                    if !root.pending-is-playlist || root.pending-has-selected-video: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: play-next-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: root.in-playlist ? "Play Next in Playlist" : "Play Next in Queue";
                                color: Theme.fg;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        play-next-touch := TouchArea {
                            clicked => {
                                root.options-open = false;
                                root.pending-open = false;
                                root.pending-queue-next-requested();
                            }
                        }
                    }

                    if !root.pending-is-playlist || root.pending-has-selected-video: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: add-playlist-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: root.in-playlist ? "Add to Another Playlist" : "Add to Playlist";
                                color: Theme.fg;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        add-playlist-touch := TouchArea {
                            clicked => {
                                root.options-open = false;
                                root.picker-append = false;
                                root.picker-open = true;
                            }
                        }
                    }

                    if root.pending-is-playlist: Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: append-playlist-touch.has-hover ? Theme.elevated : transparent;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: start;

                            Text {
                                text: "Append to Playlist";
                                color: Theme.fg;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }

                        append-playlist-touch := TouchArea {
                            clicked => {
                                root.options-open = false;
                                root.picker-append = true;
                                root.picker-open = true;
                            }
                        }
                    }
                }
            }
        }

        // The playlist picker sits above the dialog content, so a click
        // anywhere outside the picker only closes the picker.
        if root.picker-open: Rectangle {
            x: 0;
            y: 0;
            width: pending-panel.width;
            height: pending-panel.height;
            background: #00000066;

            TouchArea {
                clicked => {
                    root.picker-open = false;
                }
            }

            picker := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 40px, 360px);
                height: min(parent.height - 40px, 420px);
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.panel;
                drop-shadow-blur: 18px;
                drop-shadow-color: #000000c0;

                TouchArea { }

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "Add to Playlist";
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 4px;
                            padding-right: 10px;

                            for playlist in root.playlists: Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: picker-touch.has-hover ? Theme.elevated : transparent;

                                HorizontalLayout {
                                    alignment: start;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: playlist.name;
                                        color: Theme.fg;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: left;
                                    }
                                }

                                picker-touch := TouchArea {
                                    clicked => {
                                        root.picker-open = false;
                                        if root.pending-is-playlist && root.picker-append {
                                            root.pending-append-playlist(playlist.id);
                                        } else {
                                            root.pending-add-to-playlist(playlist.id);
                                        }
                                    }
                                }
                            }
                        }
                    }

                    FlatButton {
                        height: 32px;
                        label: root.pending-is-playlist && root.picker-append ? "Append to New Playlist" : "Add to New Playlist";
                        primary: true;
                        clicked => {
                            root.picker-open = false;
                            if root.pending-is-playlist && root.picker-append {
                                root.pending-append-playlist-new();
                            } else {
                                root.pending-add-to-new-playlist();
                            }
                        }
                    }

                    FlatButton {
                        height: 32px;
                        label: "Cancel";
                        clicked => {
                            root.picker-open = false;
                        }
                    }
                }
            }
        }
    }
}
