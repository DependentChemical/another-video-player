import { Theme } from "../theme.slint";
import { ChevronRightIcon, Icon, SpeedIcon, TuneIcon } from "../widgets.slint";

export component SettingsMenu inherits Rectangle {
    in property <bool> open: false;
    in property <bool> speed-mode: false;
    in property <string> source-quality-label: "";
    in property <float> playback-speed: 1.0;
    callback close-requested();
    callback sources-requested();
    callback speed-mode-requested();
    callback speed-changed(float);

    width: 240px;
    height: rows.preferred-height;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: #000000a6;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
    visible: root.open;

    private property <float> snapped-speed:
        Math.abs(root.playback-speed - 0.5) < 0.04 ? 0.5
        : Math.abs(root.playback-speed - 1.0) < 0.04 ? 1.0
        : Math.abs(root.playback-speed - 1.5) < 0.04 ? 1.5
        : Math.abs(root.playback-speed - 2.0) < 0.04 ? 2.0
        : root.playback-speed;
    private property <string> speed-label:
        Math.abs(root.snapped-speed - 1.0) < 0.01 ? "1x"
        : Math.abs(root.snapped-speed - 0.5) < 0.01 ? "0.5x"
        : Math.abs(root.snapped-speed - 1.5) < 0.01 ? "1.5x"
        : Math.abs(root.snapped-speed - 2.0) < 0.01 ? "2x"
        : Math.round(root.snapped-speed * 100) / 100 + "x";

    function snap-speed(speed: float) -> float {
        Math.abs(speed - 0.5) < 0.06 ? 0.5
        : Math.abs(speed - 1.0) < 0.06 ? 1.0
        : Math.abs(speed - 1.5) < 0.06 ? 1.5
        : Math.abs(speed - 2.0) < 0.06 ? 2.0
        : speed
    }

    function speed-fill-color() -> color {
        if (root.playback-speed <= 1.0) {
            let t = clamp(root.playback-speed, 0.0, 1.0);
            return rgb(76, Math.round(245 * (1 - t) + 139 * t), Math.round(139 * (1 - t) + 245 * t));
        }
        let t = clamp(root.playback-speed - 1.0, 0.0, 1.0);
        return rgb(Math.round(76 * (1 - t) + 229 * t), Math.round(139 * (1 - t) + 83 * t), Math.round(245 * (1 - t) + 75 * t));
    }

    rows := VerticalLayout {
        padding: 8px;
        spacing: 2px;

        if !root.speed-mode: Rectangle {
            height: 40px;
            border-radius: 8px;
            background: sources-touch.pressed ? Theme.elevated : (sources-touch.has-hover ? #ffffff14 : transparent);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 10px;
                cross-axis-alignment: center;

                Text {
                    text: "Sources";
                    color: Theme.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.source-quality-label;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    ChevronRightIcon { ink: Theme.muted; }
                }
            }

            sources-touch := TouchArea {
                clicked => { root.sources-requested(); }
            }
        }

        if !root.speed-mode: Rectangle {
            height: 40px;
            border-radius: 8px;
            background: speed-touch.pressed ? Theme.elevated : (speed-touch.has-hover ? #ffffff14 : transparent);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 10px;
                cross-axis-alignment: center;

                Text {
                    text: "Playback Speed";
                    color: Theme.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.speed-label;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    ChevronRightIcon { ink: Theme.muted; }
                }
            }

            speed-touch := TouchArea {
                clicked => { root.speed-mode-requested(); }
            }
        }

        if root.speed-mode: VerticalLayout {
            padding: 8px;
            spacing: 12px;

            Text {
                text: "Playback Speed";
                color: Theme.fg;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                height: 44px;
                border-radius: 8px;
                background: #ffffff08;

                track := Rectangle {
                    y: (parent.height - 4px) / 2;
                    width: parent.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.border;
                }

                // The notches mark the snap points 0, 0.5, 1.0, 1.5 and 2.0.
                // They sit on the track line and are drawn on top of it.
                Rectangle {
                    x: 0px;
                    y: (parent.height - 4px) / 2;
                    width: 2px;
                    height: 4px;
                    background: #ffffff80;
                }
                Rectangle {
                    x: parent.width * 0.25 - 1px;
                    y: (parent.height - 4px) / 2;
                    width: 2px;
                    height: 4px;
                    background: #ffffff80;
                }
                Rectangle {
                    x: parent.width * 0.5 - 1px;
                    y: (parent.height - 4px) / 2;
                    width: 2px;
                    height: 4px;
                    background: #ffffff80;
                }
                Rectangle {
                    x: parent.width * 0.75 - 1px;
                    y: (parent.height - 4px) / 2;
                    width: 2px;
                    height: 4px;
                    background: #ffffff80;
                }
                Rectangle {
                    x: parent.width - 2px;
                    y: (parent.height - 4px) / 2;
                    width: 2px;
                    height: 4px;
                    background: #ffffff80;
                }

                fill := Rectangle {
                    y: (parent.height - 4px) / 2;
                    height: 4px;
                    border-radius: 2px;
                    background: root.speed-fill-color();
                    x: root.playback-speed >= 1.0 ? parent.width / 2 : parent.width / 2 - parent.width * 0.5 * clamp(1.0 - root.playback-speed, 0.0, 1.0);
                    width: root.playback-speed >= 1.0 ? parent.width * 0.5 * clamp(root.playback-speed - 1.0, 0.0, 1.0) : parent.width * 0.5 * clamp(1.0 - root.playback-speed, 0.0, 1.0);
                }

                knob := Rectangle {
                    x: parent.width * clamp(root.playback-speed / 2.0, 0.0, 1.0) - self.width / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: speed-area.has-hover ? #5a9bf5 : Theme.accent;
                }

                speed-area := TouchArea {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    moved => {
                        root.speed-changed(root.snap-speed(clamp((self.mouse-x / max(1px, self.width)) * 2.0, 0.0, 2.0)));
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down) {
                            root.speed-changed(root.snap-speed(clamp((self.mouse-x / max(1px, self.width)) * 2.0, 0.0, 2.0)));
                        }
                        if (event.kind == PointerEventKind.up) {
                            root.speed-changed(root.snap-speed(clamp((self.mouse-x / max(1px, self.width)) * 2.0, 0.0, 2.0)));
                        }
                    }
                }

                // The labels under the slider name the snap points, so the
                // user knows where 0, 0.5, 1.0, 1.5 and 2.0 sit without guessing.
                Rectangle {
                    width: parent.width;
                    height: 16px;
                    Text {
                        x: 0px;
                        text: "0";
                        color: Theme.muted;
                        font-size: 10px;
                    }
                    Text {
                        x: parent.width * 0.25 - 10px;
                        text: "0.5x";
                        color: Theme.muted;
                        font-size: 10px;
                    }
                    Text {
                        x: parent.width * 0.5 - 10px;
                        text: "1x";
                        color: Theme.muted;
                        font-size: 10px;
                    }
                    Text {
                        x: parent.width * 0.75 - 10px;
                        text: "1.5x";
                        color: Theme.muted;
                        font-size: 10px;
                    }
                    Text {
                        x: parent.width - 12px;
                        text: "2x";
                        color: Theme.muted;
                        font-size: 10px;
                    }
                }
            }
        }
    }
}