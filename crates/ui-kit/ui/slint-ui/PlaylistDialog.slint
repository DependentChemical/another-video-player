import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { CloseButton, FlatButton, PlayIcon } from "../widgets.slint";
import { PlaylistItem } from "types.slint";

// The list of every playlist, shown from the sidebar.
//
// The built-in active queue is part of the list, so selecting a playlist is
// always the same interaction whether it is built in or user created.
export component PlaylistDialog inherits Rectangle {
    in-out property <bool> open: false;
    in property <[PlaylistItem]> items: [];
    callback playlist-selected(string);
    callback create-requested();
    callback dismissed();

    background: #00000088;

    TouchArea {
        clicked => {
            root.open = false;
            root.dismissed();
        }
    }

    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 40px, 520px);
        height: min(root.height - 40px, 560px);
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000c0;

        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "Playlists";
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                CloseButton {
                    clicked => {
                        root.open = false;
                        root.dismissed();
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 4px;
                    padding-right: 12px;

                    for item in root.items: Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: item.active
                            ? Theme.elevated
                            : (touch.has-hover ? Theme.elevated : transparent);

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                background: transparent;

                                if item.active: PlayIcon {
                                    width: 16px;
                                    height: 16px;
                                    ink: Theme.accent;
                                }
                            }

                            Text {
                                text: item.name;
                                color: Theme.fg;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: item.is-active-queue ? "Built in" : "Playlist";
                                color: Theme.muted;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        touch := TouchArea {
                            clicked => {
                                root.open = false;
                                root.playlist-selected(item.id);
                            }
                        }
                    }
                }
            }

            FlatButton {
                height: 36px;
                label: "Create a New Playlist";
                primary: true;
                clicked => {
                    root.create-requested();
                }
            }
        }
    }
}
