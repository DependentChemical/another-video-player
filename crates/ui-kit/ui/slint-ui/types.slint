/// One row of the source picker.
export struct StreamItem {
    id: string,
    label: string,
    detail: string,
}

/// A span of the media that is already downloaded.
///
/// Both ends are fractions of the axis the scrubber shows, so the same value
/// works for a recorded media and for the window of a live stream.
export struct BufferedRange {
    start: float,
    end: float,
}

/// A marked span on the scrubber, such as a SponsorBlock segment.
///
/// Both ends are fractions of the axis the scrubber shows, and the colour
/// identifies the kind of segment it represents.
export struct SponsorSegment {
    start: float,
    end: float,
    color: color,
}

/// One row of the queue dialog.
export struct QueueItem {
    /// The stable database id of the entry, used to remove exactly one row.
    id: int,
    /// The visual index of the row in the queue list, used for drag reorder.
    index: int,
    /// The position of the entry in the active queue.
    position: int,
    title: string,
    uploader: string,
    thumbnail: image,
    /// Whether this is the entry that plays now.
    current: bool,
    /// The URL of the media, used for copying.
    url: string,
}

/// One row of the history dialog.
export struct HistoryItem {
    title: string,
    uploader: string,
    url: string,
}

/// One playlist in the playlist list and every playlist picker.
export struct PlaylistItem {
    /// The stable id handed back when the playlist is picked.
    id: string,
    /// The name shown to the user.
    name: string,
    /// Whether this is the playlist the player is on.
    active: bool,
    /// Whether this is the built-in active queue.
    is-active-queue: bool,
}