import { Theme } from "../theme.slint";
import { FlatButton, FullscreenButton, GearButton, LiveButton, PlayPauseButton, SeekBar, VolumeIcon, VolumeOffIcon } from "../widgets.slint";

export component PlayerControls inherits Rectangle {
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <float> volume: 100;
    in property <string> time-text: "0:00 / 0:00";
    in property <bool> live: false;
    in property <bool> at-live-edge: true;
    in property <bool> fullscreen: false;
    in property <bool> sources-open: false;
    in property <bool> has-media: false;
    in property <bool> controls-visible: true;
    in property <length> container-height: 0;
    callback play-toggled();
    callback seek-requested(float);
    callback volume-requested(float);
    callback volume-toggled();
    callback fullscreen-toggled();
    callback live-requested();
    callback pointer-activity();
    callback controls-hovered(bool);
    callback sources-toggled();

    width: root.width;
    height: Theme.controls-height;
    background: #000000a6;
    opacity: root.controls-visible ? 1 : 0;
    y: root.controls-visible ? root.container-height - Theme.controls-height : root.container-height;
    animate y { duration: 180ms; easing: ease-out; }
    animate opacity { duration: 140ms; }

    TouchArea {
        width: root.width;
        height: root.height;
        changed has-hover => {
            root.controls-hovered(self.has-hover);
        }

        PlayPauseButton {
            x: 12px;
            y: (root.height - 32px) / 2;
            width: 44px;
            height: 32px;
            playing: root.playing;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.play-toggled();
            }
        }

        LiveButton {
            x: 60px;
            y: (root.height - 32px) / 2;
            width: 82px;
            height: 32px;
            visible: root.live;
            at-edge: root.at-live-edge;
            label: root.time-text;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.live-requested();
            }
        }

        Text {
            x: 68px;
            width: 64px;
            visible: !root.live;
            text: root.time-text;
            color: Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
        }

        seek := SeekBar {
            x: root.live ? 152px : 140px;
            y: (root.height - 18px) / 2;
            width: root.width - (root.live ? 152px : 140px) - 220px;
            height: 18px;
            value: root.position;
            maximum: root.duration;
            pointer-activity => { root.pointer-activity(); }
            moved(value) => {
                root.seek-requested(value);
            }
        }

        GearButton {
            x: root.width - 212px;
            y: (root.height - 32px) / 2;
            width: 32px;
            height: 32px;
            active: root.sources-open;
            enabled: root.has-media;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.sources-toggled();
            }
        }

        Rectangle {
            x: root.width - 40px - 90px - 20px - 26px;
            y: (root.height - 24px) / 2;
            width: 24px;
            height: 24px;
            border-radius: 4px;
            background: volume-touch.pressed ? Theme.elevated : transparent;

            if root.volume <= 0: VolumeOffIcon {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
            }
            if root.volume > 0: VolumeIcon {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
            }

            volume-touch := TouchArea {
                x: 0px;
                y: 0px;
                width: root.width;
                height: root.height;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move { root.pointer-activity(); }
                }
                clicked => {
                    root.volume-toggled();
                }
            }
        }

        volume := SeekBar {
            x: root.width - 40px - 90px - 20px;
            y: (root.height - 18px) / 2;
            width: 90px;
            height: 18px;
            value: root.volume;
            maximum: 200;
            moved(value) => {
                root.pointer-activity();
                root.volume-requested(value);
            }
        }

        FullscreenButton {
            x: root.width - 40px - 12px;
            y: (root.height - 32px) / 2;
            width: 40px;
            height: 32px;
            fullscreen: root.fullscreen;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.fullscreen-toggled();
            }
        }
    }
}