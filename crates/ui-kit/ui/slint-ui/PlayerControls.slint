import { Theme } from "../theme.slint";
import { FlatButton, FullscreenButton, GearButton, LiveButton, PauseIcon, PlayIcon, PreviousIcon, NextIcon, SeekBar, VolumeIcon, VolumeOffIcon } from "../widgets.slint";
import { BufferedRange, SponsorSegment } from "types.slint";
import { SettingsMenu } from "SettingsMenu.slint";

export component PlayerControls inherits Rectangle {
    in property <bool> playing: false;
    in property <float> position: 0;
    in property <float> duration: 0;
    in property <[BufferedRange]> buffered-ranges: [];
    in property <[SponsorSegment]> sponsor-segments: [];
    in property <float> volume: 100;
    in property <string> time-text: "0:00 / 0:00";
    in property <bool> live: false;
    in property <bool> at-live-edge: true;
    in property <bool> fullscreen: false;
    in property <bool> settings-open: false;
    in-out property <bool> settings-speed-mode: false;
    in property <string> source-quality-label: "Auto";
    in property <float> playback-speed: 1.0;
    in property <bool> has-media: false;
    in property <bool> controls-visible: true;
    in property <length> container-height: 0;
    callback play-toggled();
    callback seek-requested(float);
    callback volume-requested(float);
    callback volume-toggled();
    callback fullscreen-toggled();
    callback live-requested();
    callback pointer-activity();
    callback controls-hovered(bool);
    callback interacting-changed(bool);
    callback settings-toggled();
    callback settings-closed();
    callback sources-requested();
    callback speed-mode-requested();
    callback speed-changed(float);
    callback previous-requested();
    callback next-requested();

    width: root.width;
    height: Theme.controls-height;
    background: #000000a6;
    opacity: root.controls-visible ? 1 : 0;
    y: root.controls-visible ? root.container-height - Theme.controls-height : root.container-height;
    animate y { duration: 180ms; easing: ease-out; }
    animate opacity { duration: 140ms; }

    private property <bool> interacting: false;

    TouchArea {
        width: root.width;
        height: root.height;
        changed has-hover => {
            root.controls-hovered(self.has-hover);
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.interacting = true;
                root.interacting-changed(true);
            }
            if event.kind == PointerEventKind.up {
                root.interacting = false;
                root.interacting-changed(false);
            }
        }

        HorizontalLayout {
            padding: 12px;
            spacing: 12px;
            cross-axis-alignment: center;

            // Grouped Previous / PlayPause / Next buttons as a single pill.
            playback-controls := Rectangle {
                height: 32px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                background: Theme.panel;

                HorizontalLayout {
                    spacing: 0px;

                    Rectangle {
                        width: 44px;
                        background: previous-touch.pressed ? Theme.elevated : (previous-touch.has-hover ? Theme.elevated : Theme.panel);

                        PreviousIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                        }

                        previous-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move { root.pointer-activity(); }
                            }
                            moved => { root.pointer-activity(); }
                            clicked => {
                                root.previous-requested();
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }

                    Rectangle {
                        width: 44px;
                        background: play-touch.pressed ? Theme.elevated : (play-touch.has-hover ? Theme.elevated : Theme.panel);

                        if !root.playing: PlayIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                        }
                        if root.playing: PauseIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                        }

                        play-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move { root.pointer-activity(); }
                            }
                            moved => { root.pointer-activity(); }
                            clicked => {
                                root.play-toggled();
                            }
                        }
                    }

                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }

                    Rectangle {
                        width: 44px;
                        background: next-touch.pressed ? Theme.elevated : (next-touch.has-hover ? Theme.elevated : Theme.panel);

                        NextIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                        }

                        next-touch := TouchArea {
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.move { root.pointer-activity(); }
                            }
                            moved => { root.pointer-activity(); }
                            clicked => {
                                root.next-requested();
                            }
                        }
                    }
                }
            }

            if root.live: LiveButton {
                width: 82px;
                height: 32px;
                at-edge: root.at-live-edge;
                label: root.time-text;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.live-requested();
                }
            }
            if !root.live: Text {
                text: root.time-text;
                color: Theme.fg;
                font-size: 12px;
                vertical-alignment: center;
            }

            seek := SeekBar {
                horizontal-stretch: 1;
                height: 18px;
                value: root.position;
                maximum: root.duration;
                buffered-ranges: root.buffered-ranges;
                sponsor-segments: root.sponsor-segments;
                pointer-activity => { root.pointer-activity(); }
                moved(value) => {
                    root.seek-requested(value);
                }
                drag-started => {
                    root.interacting = true;
                    root.interacting-changed(true);
                }
                drag-ended => {
                    root.interacting = false;
                    root.interacting-changed(false);
                }
            }

            gear-button := GearButton {
                width: 32px;
                height: 32px;
                active: root.settings-open;
                enabled: root.has-media;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.settings-toggled();
                }
            }

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 4px;
                background: volume-touch.pressed ? Theme.elevated : (volume-touch.has-hover ? Theme.elevated : transparent);

                if root.volume <= 0: VolumeOffIcon {
                    width: 24px;
                    height: 24px;
                }
                if root.volume > 0: VolumeIcon {
                    width: 24px;
                    height: 24px;
                }

                volume-touch := TouchArea {
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move { root.pointer-activity(); }
                        if event.kind == PointerEventKind.down {
                            root.interacting = true;
                            root.interacting-changed(true);
                        }
                        if event.kind == PointerEventKind.up {
                            root.interacting = false;
                            root.interacting-changed(false);
                        }
                    }
                    clicked => {
                        root.volume-toggled();
                    }
                }
            }

            volume := SeekBar {
                width: 90px;
                height: 18px;
                value: root.volume;
                maximum: 100;
                moved(value) => {
                    root.pointer-activity();
                    root.volume-requested(value);
                }
                drag-started => {
                    root.interacting = true;
                    root.interacting-changed(true);
                }
                drag-ended => {
                    root.interacting = false;
                    root.interacting-changed(false);
                }
            }

            FullscreenButton {
                width: 40px;
                height: 32px;
                fullscreen: root.fullscreen;
                pointer-activity => { root.pointer-activity(); }
                clicked => {
                    root.fullscreen-toggled();
                }
            }
        }
    }

    // The settings popup sits directly above the control bar, like the
    // options menu of a YouTube video: the rect's bottom edge is the top
    // edge of the bar and the panel stretches up by the menu's own height,
    // so the menu grows with its rows and stays pinned to the bar.
    // The overlay covers the whole video area so a click anywhere outside
    // the menu dismisses it, and the menu's right edge aligns with the
    // right edge of the gear button.
    if root.settings-open: Rectangle {
        x: 0;
        y: -(root.container-height - Theme.controls-height);
        width: root.width;
        height: root.container-height - Theme.controls-height;
        background: transparent;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.settings-closed(); }
        }

        settings-menu := SettingsMenu {
            x: gear-button.x + gear-button.width - self.width;
            y: parent.height - self.height;
            open: true;
            speed-mode: root.settings-speed-mode;
            source-quality-label: root.source-quality-label;
            playback-speed: root.playback-speed;
            close-requested => { root.settings-closed(); }
            sources-requested => { root.sources-requested(); }
            speed-mode-requested => { root.settings-speed-mode = true; }
            speed-changed(value) => { root.speed-changed(value); }
        }
    }
}