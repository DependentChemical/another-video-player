import { Theme } from "../theme.slint";
import { FlatButton } from "../widgets.slint";

export component TopBar inherits Rectangle {
    in-out property <string> url: "";
    in property <string> app-name: "Flatline";
    callback load-requested();
    callback pointer-activity();

    height: Theme.bar-height;
    background: Theme.panel;

    Text {
        x: 40px;
        width: 72px;
        text: root.app-name;
        color: Theme.fg;
        font-size: 15px;
        vertical-alignment: center;
    }

    Image {
        x: 14px;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        source: @image-url("../../../../resources/flatline-32.png");
        image-fit: contain;
    }

    url-field := Rectangle {
        x: 118px;
        y: (parent.height - 32px) / 2;
        width: parent.width - 118px - 68px;
        height: 32px;
        border-radius: 6px;
        border-width: 1px;
        border-color: url-input.has-focus ? Theme.accent : Theme.border;
        background: Theme.elevated;

        url-placeholder := Text {
            x: 10px;
            text: "Paste a video URL and press Enter";
            color: Theme.muted;
            font-size: 13px;
            vertical-alignment: center;
            visible: url-input.text == "";
        }

        url-input := TextInput {
            x: 10px;
            y: 0px;
            width: parent.width - 20px;
            height: parent.height;
            text <=> root.url;
            color: Theme.fg;
            font-size: 13px;
            vertical-alignment: center;
            accepted => {
                root.load-requested();
            }
        }
    }

    load-button := FlatButton {
        x: parent.width - 56px;
        y: (parent.height - 32px) / 2;
        width: 40px;
        height: 32px;
        label: "Go";
        primary: true;
        pointer-activity => { root.pointer-activity(); }
        clicked => {
            root.load-requested();
        }
    }
}