import { Theme } from "../theme.slint";
import { FlatButton } from "../widgets.slint";

export component TopBar inherits Rectangle {
    in-out property <string> url: "";
    in property <string> app-name: "Flatline";
    callback load-requested();
    callback pointer-activity();

    height: Theme.bar-height;
    background: Theme.panel;

    HorizontalLayout {
        padding: (parent.height - 32px) / 2;
        spacing: (parent.height - 32px) / 2;
        cross-axis-alignment: center;

        Image {
            width: 20px;
            height: 20px;
            source: @image_url("../../../../resources/flatline-32.png");
            image-fit: contain;
        }

        Text {
            text: root.app-name;
            color: Theme.fg;
            font-size: 15px;
            vertical-alignment: center;
        }

        url-field := Rectangle {
            horizontal-stretch: 1;
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: url-input.has-focus ? Theme.accent : Theme.border;
            background: Theme.elevated;

            HorizontalLayout {
                padding: 10px;
                cross-axis-alignment: center;

                url-placeholder := Text {
                    text: "Paste a video URL and press Enter";
                    color: Theme.muted;
                    font-size: 13px;
                    visible: url-input.text == "";
                }

                url-input := TextInput {
                    horizontal-stretch: 1;
                    text <=> root.url;
                    color: Theme.fg;
                    font-size: 13px;
                    accepted => {
                        root.load-requested();
                    }
                }
            }
        }

        load-button := FlatButton {
            width: 40px;
            height: 32px;
            label: "Go";
            primary: true;
            pointer-activity => { root.pointer-activity(); }
            clicked => {
                root.load-requested();
            }
        }
    }
}
