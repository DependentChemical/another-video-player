import { Theme } from "../theme.slint";

export struct ToastItem {
    text: string,
    id: int,
}

export component Toast inherits Rectangle {
    in property <ToastItem> item;
    in property <length> toast-max-width: 380px;
    // The number of lines a notification shows. The text that does not fit
    // is cut off and the last line ends in an ellipsis.
    in property <int> toast-max-lines: 4;

    max-width: root.toast-max-width;
    min-width: 220px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000a0;

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        cross-axis-alignment: center;

        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.danger;
        }

        Text {
            width: Math.min(root.toast-max-width - 46px, 334px);
            text: root.item.text;
            color: Theme.fg;
            font-size: 13px;
            vertical-alignment: top;
            horizontal-alignment: left;
            wrap: word-wrap;
            max-lines: root.toast-max-lines;
            overflow: elide;
        }
    }
}

export component ToastList inherits Rectangle {
    in property <[ToastItem]> toasts: [];
    in property <length> toast-max-width: 380px;
    in property <int> toast-max-lines: 4;
    in property <length> spacing: 8px;

    VerticalLayout {
        spacing: root.spacing;
        alignment: end;
        for toast in root.toasts: Toast {
            item: toast;
            toast-max-width: root.toast-max-width;
            toast-max-lines: root.toast-max-lines;
        }
    }
}
