# Rust
/target/
**/*.rs.bk

# Flatline managed runtime state (downloaded yt-dlp, thumbnails, config)
.flatline/

# The cookie files and the browser profile of the sign-in helper hold the
# credentials of the signed-in services, so they never belong in the
# repository.
/cache/
/user-data/

# The Material Icons font, downloaded when the interface is built
/crates/ui-kit/fonts/

# Build output of `cargo xtask package`
/dist/
/out/

# Research material and scratch files (reference projects, screenshots, logs)
/.ref/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
