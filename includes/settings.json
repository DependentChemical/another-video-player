{
  "Video-Settings": {
    "display-name": "Video Settings",
    "global": {
      "sources-default": {
        "video": "best,default",
        "audio": "default,best",
        "combined": "default,best"
      }
    },
    "per-site": {
      "display-name": "Per-Site Settings",
      "spawnable": {
        "id-value": {
          "display-name": "Name of the site",
          "regex": "Regex for the site source URL",
          "sources-default": {
            "display-name": "Defaults for sources",
            "video": "Default video size",
            "audio": "Default audio quality",
            "combined": "Default combined quality"
          }
        }
      },
      "main-list": {
        "Youtube": {
          "regex": "(?i)^(https?://)?(www\\.|m\\.)?(youtube\\.com|youtu\\.be)/",
          "sources-default": {
            "video": "720,default,best",
            "audio": "default,best",
            "combined": "720,default,best"
          }
        }
      }
    }
  },
  "Player-Settings": {
    "display-name": "Player Settings",
    "Pre-Buffer": {
      "display-name": "Pre-Buffer Duration",
      "description": "Seconds of content to buffer before starting playback",
      "type": "integer",
      "minimum": 0,
      "default": 10,
      "value": null
    },
    "SponsorBlock": {
      "display-name": "SponsorBlock",
      "description": "Automatically skip labeled segments in YouTube videos",
      "sponsor": {
        "display-name": "Sponsor",
        "default": true,
        "value": null
      },
      "selfpromo": {
        "display-name": "Self Promotion",
        "default": true,
        "value": null
      },
      "interaction": {
        "display-name": "Interaction Reminder",
        "default": true,
        "value": null
      },
      "intro": {
        "display-name": "Intro",
        "default": true,
        "value": null
      },
      "outro": {
        "display-name": "Outro",
        "default": true,
        "value": null
      },
      "preview": {
        "display-name": "Preview",
        "default": true,
        "value": null
      },
      "hook": {
        "display-name": "Hook",
        "default": true,
        "value": null
      },
      "filler": {
        "display-name": "Filler",
        "default": true,
        "value": null
      }
    }
  },
  "Logging": {
    "display-name": "Logging",
    "level": {
      "display-name": "Log Level",
      "description": "Lowest severity written to flatline.log. DEBUG records everything, NOTICE adds playback and queue events, WARNING adds recoverable failures, ERROR only records failures.",
      "type": "select",
      "options": ["DEBUG", "NOTICE", "WARNING", "ERROR"],
      "default": "NOTICE",
      "value": "DEBUG"
    }
  }
}
