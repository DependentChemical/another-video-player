{
  "Video-Settings": {
    "display-name": "Video Settings",
    "global": {
      "sources-default": {
        "video": "best,default",
        "audio": "default,best",
        "combined": "default,best"
      }
    },
    "per-site": {
      "display-name": "Per-Site Settings",
      "spawnable": {
        "id-value": {
          "display-name": "Name of the site",
          "regex": "Regex for the site source URL",
          "sources-default": {
            "display-name": "Defaults for sources",
            "video": "Default video size",
            "audio": "Default audio quality",
            "combined": "Default combined quality"
          }
        }
      },
      "main-list": {
        "Youtube": {
          "regex": "(?i)^(https?://)?(www\\.|m\\.)?(youtube\\.com|youtu\\.be)/",
          "sources-default": {
            "video": "720,default,best",
            "audio": "default,best",
            "combined": "720,default,best"
          },
          "yt-dlp-args": {
            "display-name": "yt-dlp Arguments",
            "description": "Arguments appended to yt-dlp for URLs matching this site",
            "extra": "--extractor-args \"youtube:player_js_variant=tv\""
          }
        }
      }
    }
  },
  "Player-Settings": {
    "display-name": "Player Settings",
    "Pre-Buffer": {
      "display-name": "Pre-Buffer Duration",
      "description": "Seconds of content to buffer before starting playback",
      "type": "integer",
      "minimum": 0,
      "default": 10,
      "value": null
    },
    "SponsorBlock": {
      "display-name": "SponsorBlock",
      "description": "Automatically skip labeled segments in YouTube videos",
      "sponsor": {
        "display-name": "Sponsor",
        "default": true,
        "value": null
      },
      "selfpromo": {
        "display-name": "Self Promotion",
        "default": true,
        "value": null
      },
      "interaction": {
        "display-name": "Interaction Reminder",
        "default": true,
        "value": null
      },
      "intro": {
        "display-name": "Intro",
        "default": true,
        "value": null
      },
      "outro": {
        "display-name": "Outro",
        "default": true,
        "value": null
      },
      "preview": {
        "display-name": "Preview",
        "default": true,
        "value": null
      },
      "hook": {
        "display-name": "Hook",
        "default": true,
        "value": null
      },
      "filler": {
        "display-name": "Filler",
        "default": true,
        "value": null
      }
    }
  },
  "Logging": {
    "display-name": "Logging",
    "level": {
      "display-name": "Log Level",
      "description": "Lowest severity written to flatline.log. DEBUG records everything, NOTICE adds playback and queue events, WARNING adds recoverable failures, ERROR only records failures.",
      "type": "select",
      "options": [
        "DEBUG",
        "NOTICE",
        "WARNING",
        "ERROR"
      ],
      "default": "NOTICE",
      "value": "DEBUG"
    }
  },
  "YtDlp-Settings": {
    "display-name": "yt-dlp Settings",
    "force-ipv4": {
      "display-name": "Force IPv4",
      "description": "Pass -4 to yt-dlp to avoid IPv6 stalls",
      "type": "boolean",
      "default": false,
      "value": null
    },
    "socket-timeout": {
      "display-name": "Socket Timeout (s)",
      "description": "yt-dlp --socket-timeout seconds",
      "type": "integer",
      "minimum": 5,
      "maximum": 120,
      "default": 15,
      "value": null
    },
    "extractor-retries": {
      "display-name": "Extractor Retries",
      "description": "yt-dlp --extractor-retries",
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 3,
      "value": null
    },
    "js-runtime": {
      "display-name": "JavaScript Runtime",
      "description": "The JavaScript runtime yt-dlp uses to solve YouTube EJS challenges",
      "type": "select",
      "options": [
        "deno"
      ],
      "default": "deno",
      "value": "deno"
    },
    "Extra-Args": {
      "display-name": "Extra Arguments",
      "description": "Custom command-line arguments passed to yt-dlp for every resolve",
      "type": "string",
      "default": null,
      "value": null
    }
  }
}
